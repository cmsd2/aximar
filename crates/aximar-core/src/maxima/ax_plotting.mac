/* ax_plotting.mac — Aximar interactive plotting functions
 *
 * Provides ax_plot2d, ax_draw2d, ax_draw3d which produce Plotly.js JSON specs.
 * These functions reuse Maxima's draw package object syntax (explicit, parametric,
 * points, implicit) but render with Plotly instead of gnuplot.
 *
 * Data transfer: JSON is written to a temp file (.plotly.json) and the path is
 * printed to stdout, where the Aximar parser detects and reads it.
 */

/* NOTE: aximar bundles this file and pushes it through session init
   (see crates/aximar-core/src/maxima/plotting.rs).  It is ax-plots 0.2.0
   (cmsd2/ax-plots ax-plots.mac at v0.2.0) with two local changes:

   - The companion Lisp helpers are shipped via :lisp stdin, and the
     package index is unused in this context, so the corresponding
     load(...) lines are omitted.
   - The emit functions deliver through kernel-events' emit_display when
     it is loaded (see "Output" below). */
load("stringproc")$

/* ========================================================================
 * JSON builder helpers
 * ======================================================================== */

/* Convert a Maxima value to a JSON-safe float string. Non-finite → "null".
   Numeric constants (%pi/2, atan(3), sqrt(2)) are floated first; anything
   that still isn't a number (free symbols, inf, und, false) → "null". */
ax__float_to_json(v) :=
  if numberp(v) and v = v then (
    block([fv: float(v)],
      if abs(fv) = inf or fv # fv then "null"
      else string(fv))
  )
  else block([fv: float(v)],
    if numberp(fv) then ax__float_to_json(fv) else "null")$

/* Convert a list of numbers to a JSON array string: "[1.0,2.0,3.0]" */
ax__float_list_to_json(lst) :=
  sconcat("[", simplode(map(ax__float_to_json, lst), ","), "]")$

/* Convert a list of lists (matrix) to a JSON 2D array string */
ax__float_matrix_to_json(mat) :=
  sconcat("[", simplode(map(ax__float_list_to_json, mat), ","), "]")$

/* Escape backslash, double quote and newline for a JSON string body */
ax__json_escape(s) := block([r: s],
  r: ssubst("\\\\", "\\", r),
  r: ssubst("\\\"", "\"", r),
  r: ssubst("\\n", ascii(10), r),
  r)$

/* Wrap a value in JSON quotes, escaping it */
ax__json_string(s) :=
  sconcat("\"", ax__json_escape(if stringp(s) then s else sconcat(s)), "\"")$

/* Build a JSON object from a list of [key, json_value_string] pairs */
ax__json_obj(pairs) := block([parts],
  parts: map(lambda([p], sconcat("\"", p[1], "\":", p[2])), pairs),
  sconcat("{", simplode(parts, ","), "}"))$

/* Build a JSON array from a list of already-serialized JSON strings */
ax__json_list(items) :=
  sconcat("[", simplode(items, ","), "]")$

/* ========================================================================
 * Optional ndarray support (numerics package)
 *
 * If the numerics package is loaded, ndarray objects are transparently
 * converted to Maxima lists/matrices before plotting. If not loaded,
 * these are identity functions. Load order does not matter.
 * ======================================================================== */

ax__maybe_list(x) := if ax__ndarray_p(x) then ax__ndarray_to_list(x) else x $
ax__maybe_matrix(x) := if ax__ndarray_p(x) then ax__ndarray_to_matrix(x) else x $

/* ========================================================================
 * Color mapping
 * ======================================================================== */

/* Map Maxima color atoms to CSS color strings */
ax__color_to_css(c) :=
  if stringp(c) then c
  else if c = red then "red"
  else if c = blue then "blue"
  else if c = green then "green"
  else if c = black then "black"
  else if c = white then "white"
  else if c = yellow then "yellow"
  else if c = orange then "orange"
  else if c = purple then "purple"
  else if c = cyan then "cyan"
  else if c = magenta then "magenta"
  else if c = gray or c = grey then "gray"
  else if c = brown then "brown"
  else if c = pink then "pink"
  else string(c)$

/* ========================================================================
 * Default style state and option handling
 * ======================================================================== */

/* Default style: list of [key, value] pairs */
ax__default_style() := [
  [color, false],           /* false = use Plotly auto color cycle */
  [fill_color, false],
  [opacity, 1.0],
  [line_width, 2],
  [dash, "solid"],
  [marker_symbol, "circle"],
  [marker_size, 6],
  [name, false],            /* false = auto-generate from expression */
  [fill, false],
  [nticks, 500],
  [nbins, false],           /* histogram: number of bins (auto if false) */
  [ncontours, false],       /* contour: number of contour levels (auto if false) */
  [showscale, 'auto],       /* heatmap/contour: 'auto = Plotly default, true/false = explicit */
  [bar_width, false],       /* bar: bar width fraction (auto if false) */
  [ngrid, 20],              /* vector field: grid resolution (ngrid x ngrid) */
  [arrow_scale, 1.0],       /* vector field: arrow length multiplier */
  [normalize, false],       /* vector field: equal-length arrows (direction only) */
  [initial_points, false],  /* streamline: list of [x0,y0] starting points (auto if false) */
  [t_range, false],         /* streamline: integration time span [t0, tf] (default [0,10]) */
  [dt, false],              /* streamline: RK4 step size (default 0.05) */
  [boxpoints, false],       /* box/violin: "all", "outliers", false (auto if false) */
  [boxmean, false],         /* box: true, "sd", or false */
  [hole, false],            /* pie: donut hole fraction 0–1 */
  [colorscale, false],      /* contour/heatmap/surface: Plotly colorscale name */
  [hover_text, false],      /* string or list of strings → Plotly hovertext */
  [hoverinfo, false],       /* e.g. "skip", "none", "x+y", "text" */
  [showlegend, 'auto],      /* per-object only (top-level showlegend is the layout option) */
  [font_size, false],       /* label: text size in px */
  [font_color, false],      /* label: text colour (defaults to color) */
  [font_family, false],     /* label: CSS font family */
  [label_alignment, false], /* label: left / center / right of the point (Plotly xanchor) */
  [label_valign, false],    /* label: top / middle / bottom of the point (Plotly yanchor) */
  [label_orientation, false], /* label: horizontal / vertical (draw-compatible) */
  [label_angle, false],     /* label: degrees counterclockwise; overrides label_orientation */
  [label_offset, false],    /* label: [dx, dy] shift in pixels, dy up (Plotly xshift/yshift) */
  [head_size, false],       /* vector: arrowhead scale relative to line width (Plotly arrowsize) */
  [head_style, false],      /* vector: arrowhead shape 0–8 (Plotly arrowhead) */
  [head_both, false],       /* vector: heads at both ends (draw-compatible) */
  [transparent, false],     /* polygon: true = outline only, no fill (draw-compatible) */
  [head_end, false],        /* lines/explicit/parametric: arrowhead at the last point */
  [head_start, false],      /* ...: arrowhead at the first point, pointing backwards */
  [head_count, 0],          /* ...: arrowheads evenly spaced (by arc length) along the curve */
  [head_direction, "tangent"], /* ...: "tangent" (local slope) or "chord" (overall direction) */
  [decoration, false],      /* lines/explicit/parametric: "snake" or "zigzag" along the path */
  [decoration_amplitude, false],  /* ...: data units; default wavelength / 4 */
  [decoration_wavelength, false], /* ...: data units; default path length / 10 */
  [decoration_pre, false],  /* ...: straight length at the start; default 0, or half a wavelength with head_start */
  [decoration_post, false], /* ...: straight length at the end; default 0, or half a wavelength with head_end */
  [filled_func, false],     /* explicit: true = fill to y=0; g(x) = fill between f and g (draw-compatible) */
  [legendgroup, false],     /* traces sharing a group toggle together in the legend */
  [line_shape, false],      /* "linear" / "spline" / "hv" / "vh" / "hvh" / "vhv" */
  [layer, false]            /* shapes: "above" (Plotly default) or "below" the data */
]$

/* Get a style value from the style state */
ax__style_get(style, key) := block([pair],
  pair: assoc(key, style),
  pair)$

/* Set a style value, returning new style.  Keys not already present are
   appended (previously they were silently dropped). */
ax__style_set(style, key, val) := block([result, found: false],
  result: [],
  for p in style do (
    if p[1] = key then (result: endcons([key, val], result), found: true)
    else result: endcons(p, result)
  ),
  if not found then result: endcons([key, val], result),
  result)$

/* Layout option names */
ax__layout_option_names : [title, xrange, yrange, zrange, grid, xaxis, yaxis,
  xlabel, ylabel, zlabel, showlegend, aspect_ratio, width, height, bar_mode,
  plot_bgcolor, paper_bgcolor, logx, logy, logz, margin, constrain,
  autosize, legend_position, legend_orientation, legend_title, layout_raw,
  title_font_size, title_x, title_align, colorway,
  xtickvals, ytickvals, xticktext, yticktext, xtickformat, ytickformat,
  xreversed, yreversed, xzeroline, yzeroline, theme, diagram,
  /* animation playback options (siblings of title/xrange/...) */
  fps, transition_duration, loop, slider_label]$

/* Trace/style option names */
ax__trace_option_names : [color, fill_color, opacity, line_width, dash,
  marker_symbol, marker_size, name, fill, colorscale, hover_text, hoverinfo,
  nticks, nbins, ncontours, showscale, bar_width,
  ngrid, arrow_scale, normalize, initial_points, t_range, dt,
  boxpoints, boxmean, hole,
  /* label */
  font_size, font_color, font_family,
  label_alignment, label_valign, label_orientation, label_angle, label_offset,
  /* vector */
  head_size, head_style, head_both,
  /* polygon */
  transparent,
  /* curves: arrowheads, fill between */
  head_end, head_start, head_count, head_direction, filled_func,
  decoration, decoration_amplitude, decoration_wavelength, decoration_pre, decoration_post,
  legendgroup, line_shape,
  /* shapes */
  layer]$

/* Options accepted only inside an object, e.g. lines(xs, ys, showlegend=false).
   At top level, showlegend is the layout option. */
ax__object_only_option_names : [showlegend]$

/* Draw object names we recognize.  `animate` is a wrapper that
   takes any other draw object and an [param, lo, hi[, n]] spec;
   it is unwrapped during the scan-pass of ax_draw2d / ax_draw3d. */
ax__draw_object_names : [explicit, parametric, points, lines, implicit,
  label, vector, polygon, ax_trace, rectangle, ellipse, hline, vline,
  ax_contour, ax_heatmap, ax_bar, ax_histogram,
  ax_vector_field, ax_streamline,
  parametric_surface, ax_contour3d, ax_vector_field3d,
  ax_box, ax_violin, ax_pie, ax_error_bar,
  animate]$

/* Check if an argument is a layout option (e.g. title="Foo") */
ax__is_layout_option(item) :=
  not atom(item) and op(item) = "=" and member(lhs(item), ax__layout_option_names)$

/* Check if an argument is a trace/style option (e.g. color=red) */
ax__is_trace_option(item) :=
  not atom(item) and op(item) = "=" and member(lhs(item), ax__trace_option_names)$

/* Check if an argument is a draw object (e.g. explicit(...)) */
ax__is_draw_object(item) :=
  not atom(item) and member(op(item), ax__draw_object_names)$

/* Apply a style option to the style state */
ax__apply_option(style, item) :=
  ax__style_set(style, lhs(item), rhs(item))$

/* Check if an argument inside a draw object is a per-object option */
ax__is_object_option(item) :=
  not atom(item) and op(item) = "=" and
  (member(lhs(item), ax__trace_option_names) or
   member(lhs(item), ax__object_only_option_names))$

/* Split trailing per-object options off a draw object:
   lines(xs, ys, color="red", dash="dot") → [lines(xs, ys), style with
   color/dash applied].  Only trailing equations whose lhs is a known
   option are taken, so implicit(x^2+y^2=1, ...) is left alone.  The
   returned style applies to this object only; the caller's sticky style
   is unchanged. */
ax__split_object_options(obj, style) := block([a, k, st],
  a: args(obj),
  k: length(a),
  while k > 0 and ax__is_object_option(a[k]) do k: k - 1,
  if k = length(a) then return([obj, style]),
  st: style,
  for i from k + 1 thru length(a) do st: ax__apply_option(st, a[i]),
  [funmake(op(obj), firstn(a, k)), st])$

/* Top-level arguments may be lists (spliced in place, at any depth) and
   group(obj, ..., opt=val, ...), which expands to its objects with the
   group's options added to each one.  Options inside a group apply to its
   objects only; each object's own options still win.  Groups nest. */
ax__expand_args(args_in) := block([out: []],
  for item in args_in do
    if listp(item) then out: append(out, ax__expand_args(item))
    else if not atom(item) and op(item) = 'group then out: append(out, ax__expand_group(item))
    else out: endcons(item, out),
  out)$

ax__expand_group(g) := block([opts: [], kids: []],
  for a in args(g) do
    if ax__is_object_option(a) then opts: endcons(a, opts)
    else if ax__is_layout_option(a) then
      error("group: layout options go outside the group, got:", a)
    else kids: endcons(a, kids),
  map(lambda([k], ax__with_options(k, opts)), ax__expand_args(kids)))$

/* Insert options before an object's own trailing options */
ax__with_options(obj, opts) := block([a, k],
  if ax__is_animate(obj) then
    return(funmake('animate, [ax__with_options(first(args(obj)), opts), second(args(obj))])),
  if not ax__is_draw_object(obj) then
    error("group: expected draw objects and options, got:", obj),
  if opts = [] then return(obj),
  a: args(obj),
  k: length(a),
  while k > 0 and ax__is_object_option(a[k]) do k: k - 1,
  funmake(op(obj), append(firstn(a, k), opts, rest(a, k))))$

/* Check that every element of a data list is numeric after float(), or an
   explicit gap (false, inf, minf, und, ind → null in the JSON).  Errors name
   the object, axis and 1-based index instead of silently emitting null. */
ax__check_numeric_data(lst, objname, axis) := block([i: 0, fv],
  for v in lst do (
    i: i + 1,
    fv: float(v),
    if not numberp(fv) and not member(v, [false, inf, minf, und, ind]) then
      error(sconcat(objname, ": ", axis, " value #", i, " is not numeric: ", string(v)))
  ),
  lst)$

/* ========================================================================
 * Sampling helpers
 * ======================================================================== */

/* Sample a 1-variable expression: returns [xs, ys] */
ax__sample_1d(expr, var, lo, hi, n) := block(
  [h, xs, ys, xv, yv],
  lo: float(lo), hi: float(hi),
  h: (hi - lo) / (n - 1),
  xs: makelist(lo + i * h, i, 0, n - 1),
  ys: makelist(
    block([yv: errcatch(float(subst(xs[i+1], var, expr)))],
      if yv = [] then false else first(yv)),
    i, 0, n - 1),
  [xs, ys])$

/* Sample a 2-variable expression for surface/contour: returns [xs, ys, z_matrix] */
ax__sample_2d(expr, xvar, xlo, xhi, yvar, ylo, yhi, nx, ny) := block(
  [xstep, ystep, xs, ys, zmat, zrow, zv],
  xlo: float(xlo), xhi: float(xhi),
  ylo: float(ylo), yhi: float(yhi),
  xstep: (xhi - xlo) / (nx - 1),
  ystep: (yhi - ylo) / (ny - 1),
  xs: makelist(xlo + i * xstep, i, 0, nx - 1),
  ys: makelist(ylo + j * ystep, j, 0, ny - 1),
  zmat: makelist(
    makelist(
      block([zv: errcatch(float(subst([xvar = xs[i+1], yvar = ys[j+1]], expr)))],
        if zv = [] then false else first(zv)),
      j, 0, ny - 1),
    i, 0, nx - 1),
  [xs, ys, zmat])$

/* Sample a parametric curve: returns [xs, ys] */
ax__sample_parametric_2d(xexpr, yexpr, tvar, tlo, thi, n) := block(
  [h, ts, xs, ys, xv, yv],
  tlo: float(tlo), thi: float(thi),
  h: (thi - tlo) / (n - 1),
  ts: makelist(tlo + i * h, i, 0, n - 1),
  xs: makelist(
    block([xv: errcatch(float(subst(ts[i+1], tvar, xexpr)))],
      if xv = [] then false else first(xv)),
    i, 0, n - 1),
  ys: makelist(
    block([yv: errcatch(float(subst(ts[i+1], tvar, yexpr)))],
      if yv = [] then false else first(yv)),
    i, 0, n - 1),
  [xs, ys])$

/* Sample an implicit equation f(x,y)=0 on a grid: returns [xs, ys, z_matrix]
   where z_matrix contains lhs-rhs evaluated on the grid, suitable for
   contour-at-zero rendering. */
ax__sample_implicit_2d(eqn, xvar, xlo, xhi, yvar, ylo, yhi, n) := block(
  [fexpr],
  /* Convert equation lhs=rhs to lhs-rhs */
  if op(eqn) = "=" then fexpr: lhs(eqn) - rhs(eqn)
  else fexpr: eqn,
  ax__sample_2d(fexpr, xvar, xlo, xhi, yvar, ylo, yhi, n, n))$

/* Sample a vector field (Fx, Fy) on a 2D grid.
   Returns [xs, ys, fxmat, fymat] where fxmat[i][j] = Fx(xs[i], ys[j]). */
ax__sample_vector_field_2d(fxexpr, fyexpr, xvar, xlo, xhi, yvar, ylo, yhi, ng) := block(
  [xstep, ystep, xs, ys, fxmat, fymat],
  xlo: float(xlo), xhi: float(xhi),
  ylo: float(ylo), yhi: float(yhi),
  xstep: (xhi - xlo) / (ng - 1),
  ystep: (yhi - ylo) / (ng - 1),
  xs: makelist(xlo + i * xstep, i, 0, ng - 1),
  ys: makelist(ylo + j * ystep, j, 0, ng - 1),
  fxmat: makelist(
    makelist(
      block([fxv: errcatch(float(subst([xvar = xs[i+1], yvar = ys[j+1]], fxexpr)))],
        if fxv = [] then 0.0 else first(fxv)),
      j, 0, ng - 1),
    i, 0, ng - 1),
  fymat: makelist(
    makelist(
      block([fyv: errcatch(float(subst([xvar = xs[i+1], yvar = ys[j+1]], fyexpr)))],
        if fyv = [] then 0.0 else first(fyv)),
      j, 0, ng - 1),
    i, 0, ng - 1),
  [xs, ys, fxmat, fymat])$

/* Sample a 3D parametric curve: returns [xs, ys, zs] */
ax__sample_parametric_3d(xexpr, yexpr, zexpr, tvar, tlo, thi, n) := block(
  [h, ts, xs, ys, zs],
  tlo: float(tlo), thi: float(thi),
  h: (thi - tlo) / (n - 1),
  ts: makelist(tlo + i * h, i, 0, n - 1),
  xs: makelist(
    block([xv: errcatch(float(subst(ts[i+1], tvar, xexpr)))],
      if xv = [] then false else first(xv)),
    i, 0, n - 1),
  ys: makelist(
    block([yv: errcatch(float(subst(ts[i+1], tvar, yexpr)))],
      if yv = [] then false else first(yv)),
    i, 0, n - 1),
  zs: makelist(
    block([zv: errcatch(float(subst(ts[i+1], tvar, zexpr)))],
      if zv = [] then false else first(zv)),
    i, 0, n - 1),
  [xs, ys, zs])$

/* Sample a parametric surface: returns [xmat, ymat, zmat] where each is a 2D matrix.
   Evaluates x(u,v), y(u,v), z(u,v) over a nu×nv grid. */
ax__sample_parametric_surface(xexpr, yexpr, zexpr, uvar, ulo, uhi, vvar, vlo, vhi, nu, nv) := block(
  [ustep, vstep, us, vs, xmat, ymat, zmat],
  ulo: float(ulo), uhi: float(uhi),
  vlo: float(vlo), vhi: float(vhi),
  ustep: (uhi - ulo) / (nu - 1),
  vstep: (vhi - vlo) / (nv - 1),
  us: makelist(ulo + i * ustep, i, 0, nu - 1),
  vs: makelist(vlo + j * vstep, j, 0, nv - 1),
  xmat: makelist(
    makelist(
      block([xv: errcatch(float(subst([uvar = us[i+1], vvar = vs[j+1]], xexpr)))],
        if xv = [] then false else first(xv)),
      j, 0, nv - 1),
    i, 0, nu - 1),
  ymat: makelist(
    makelist(
      block([yv: errcatch(float(subst([uvar = us[i+1], vvar = vs[j+1]], yexpr)))],
        if yv = [] then false else first(yv)),
      j, 0, nv - 1),
    i, 0, nu - 1),
  zmat: makelist(
    makelist(
      block([zv: errcatch(float(subst([uvar = us[i+1], vvar = vs[j+1]], zexpr)))],
        if zv = [] then false else first(zv)),
      j, 0, nv - 1),
    i, 0, nu - 1),
  [xmat, ymat, zmat])$

/* Sample f(x,y,z) on a 3D grid for isosurface rendering.
   Returns [xs_flat, ys_flat, zs_flat, vals_flat] as flat arrays
   (Plotly isosurface format: one value per grid point). */
ax__sample_3d(expr, xvar, xlo, xhi, yvar, ylo, yhi, zvar, zlo, zhi, n) := block(
  [xstep, ystep, zstep, xpts, ypts, zpts, total,
   xs_flat, ys_flat, zs_flat, vals_flat, idx, fv],
  xlo: float(xlo), xhi: float(xhi),
  ylo: float(ylo), yhi: float(yhi),
  zlo: float(zlo), zhi: float(zhi),
  xstep: (xhi - xlo) / (n - 1),
  ystep: (yhi - ylo) / (n - 1),
  zstep: (zhi - zlo) / (n - 1),
  xpts: makelist(xlo + i * xstep, i, 0, n - 1),
  ypts: makelist(ylo + j * ystep, j, 0, n - 1),
  zpts: makelist(zlo + k * zstep, k, 0, n - 1),
  /* Pre-allocate flat arrays to avoid O(n^6) endcons copying */
  total: n * n * n,
  xs_flat: makelist(0.0, total),
  ys_flat: makelist(0.0, total),
  zs_flat: makelist(0.0, total),
  vals_flat: makelist(0.0, total),
  idx: 0,
  for i: 1 thru n do
    for j: 1 thru n do
      for k: 1 thru n do (
        idx: idx + 1,
        xs_flat[idx]: xpts[i],
        ys_flat[idx]: ypts[j],
        zs_flat[idx]: zpts[k],
        fv: errcatch(float(subst([xvar = xpts[i], yvar = ypts[j], zvar = zpts[k]], expr))),
        vals_flat[idx]: if fv = [] then false else first(fv)
      ),
  [xs_flat, ys_flat, zs_flat, vals_flat])$

/* Sample a 3D vector field (Fx, Fy, Fz) on a grid.
   Returns [xs, ys, zs, us, vs, ws] as flat arrays (Plotly cone format). */
ax__sample_vector_field_3d(fxexpr, fyexpr, fzexpr, xvar, xlo, xhi, yvar, ylo, yhi, zvar, zlo, zhi, ng) := block(
  [xstep, ystep, zstep, xpts, ypts, zpts, total, idx,
   xs_flat, ys_flat, zs_flat, us_flat, vs_flat, ws_flat, fu, fv_val, fw],
  xlo: float(xlo), xhi: float(xhi),
  ylo: float(ylo), yhi: float(yhi),
  zlo: float(zlo), zhi: float(zhi),
  xstep: (xhi - xlo) / (ng - 1),
  ystep: (yhi - ylo) / (ng - 1),
  zstep: (zhi - zlo) / (ng - 1),
  xpts: makelist(xlo + i * xstep, i, 0, ng - 1),
  ypts: makelist(ylo + j * ystep, j, 0, ng - 1),
  zpts: makelist(zlo + k * zstep, k, 0, ng - 1),
  /* Pre-allocate flat arrays */
  total: ng * ng * ng,
  xs_flat: makelist(0.0, total),
  ys_flat: makelist(0.0, total),
  zs_flat: makelist(0.0, total),
  us_flat: makelist(0.0, total),
  vs_flat: makelist(0.0, total),
  ws_flat: makelist(0.0, total),
  idx: 0,
  for i: 1 thru ng do
    for j: 1 thru ng do
      for k: 1 thru ng do block(
        [subs: [xvar = xpts[i], yvar = ypts[j], zvar = zpts[k]]],
        idx: idx + 1,
        xs_flat[idx]: xpts[i],
        ys_flat[idx]: ypts[j],
        zs_flat[idx]: zpts[k],
        fu: errcatch(float(subst(subs, fxexpr))),
        us_flat[idx]: if fu = [] then 0.0 else first(fu),
        fv_val: errcatch(float(subst(subs, fyexpr))),
        vs_flat[idx]: if fv_val = [] then 0.0 else first(fv_val),
        fw: errcatch(float(subst(subs, fzexpr))),
        ws_flat[idx]: if fw = [] then 0.0 else first(fw)
      ),
  [xs_flat, ys_flat, zs_flat, us_flat, vs_flat, ws_flat])$

/* RK4 integrator for 2D ODE system dx/dt = Fx(x,y), dy/dt = Fy(x,y).
   Integrates from (x0, y0) over time t0 to tf with step h.
   Stops if trajectory leaves [xlo,xhi] x [ylo,yhi] or hits non-finite values.
   Returns list of [x,y] points. */
ax__rk4_trajectory(fxexpr, fyexpr, xvar, yvar, x0, y0, t0, tf, h, xlo, xhi, ylo, yhi) := block(
  [path, xc, yc, tc, nsteps, h2,
   k1x, k1y, k2x, k2y, k3x, k3y, k4x, k4y, xn, yn, ev],
  path: [[float(x0), float(y0)]],
  xc: float(x0), yc: float(y0),
  tc: float(t0),
  h: float(h),
  h2: h / 2.0,
  nsteps: ceiling(abs(tf - t0) / abs(h)),
  for rk_i thru nsteps do (
    ev: errcatch(block(
      [k1x, k1y, k2x, k2y, k3x, k3y, k4x, k4y, xn, yn],
      k1x: float(subst([xvar=xc, yvar=yc], fxexpr)),
      k1y: float(subst([xvar=xc, yvar=yc], fyexpr)),
      k2x: float(subst([xvar=xc+h2*k1x, yvar=yc+h2*k1y], fxexpr)),
      k2y: float(subst([xvar=xc+h2*k1x, yvar=yc+h2*k1y], fyexpr)),
      k3x: float(subst([xvar=xc+h2*k2x, yvar=yc+h2*k2y], fxexpr)),
      k3y: float(subst([xvar=xc+h2*k2x, yvar=yc+h2*k2y], fyexpr)),
      k4x: float(subst([xvar=xc+h*k3x, yvar=yc+h*k3y], fxexpr)),
      k4y: float(subst([xvar=xc+h*k3x, yvar=yc+h*k3y], fyexpr)),
      xn: xc + h*(k1x + 2*k2x + 2*k3x + k4x)/6,
      yn: yc + h*(k1y + 2*k2y + 2*k3y + k4y)/6,
      [xn, yn]
    )),
    if ev = [] then return('done),
    xn: first(first(ev)), yn: second(first(ev)),
    if not numberp(xn) or not numberp(yn) then return('done),
    if xn # xn or yn # yn then return('done), /* NaN check */
    if xn < xlo or xn > xhi or yn < ylo or yn > yhi then return('done),
    path: endcons([xn, yn], path),
    xc: xn, yc: yn,
    tc: tc + h
  ),
  path
)$

/* ========================================================================
 * Trace builders — convert draw objects to Plotly JSON trace strings
 * ======================================================================== */

/* Build common line/marker style properties from style state */
ax__build_line_style(style) := block(
  [parts, c, lw, d, ls],
  parts: [],
  c: ax__style_get(style, color),
  lw: ax__style_get(style, line_width),
  d: ax__style_get(style, dash),
  ls: ax__style_get(style, line_shape),
  if ls # false then
    parts: endcons(sconcat("\"shape\":", ax__json_string(ls)), parts),
  if c # false then
    parts: endcons(sconcat("\"color\":", ax__json_string(ax__color_to_css(c))), parts),
  if lw # false then
    parts: endcons(sconcat("\"width\":", string(lw)), parts),
  if d # false and d # "solid" then
    parts: endcons(sconcat("\"dash\":", ax__json_string(d)), parts),
  sconcat("{", simplode(parts, ","), "}"))$

ax__build_marker_style(style) := block(
  [parts, c, sz, sym],
  parts: [],
  c: ax__style_get(style, color),
  sz: ax__style_get(style, marker_size),
  sym: ax__style_get(style, marker_symbol),
  if c # false then
    parts: endcons(sconcat("\"color\":", ax__json_string(ax__color_to_css(c))), parts),
  if sz # false then
    parts: endcons(sconcat("\"size\":", string(sz)), parts),
  if sym # false and sym # "circle" then
    parts: endcons(sconcat("\"symbol\":", ax__json_string(sym)), parts),
  sconcat("{", simplode(parts, ","), "}"))$

/* Common trace-level style properties (opacity, name, fill, legend, hover) */
ax__build_trace_style(style, auto_name) := block(
  [parts, op_val, nm, fl, fc, sl, hi, ht],
  parts: [],
  op_val: ax__style_get(style, opacity),
  nm: ax__style_get(style, name),
  fl: ax__style_get(style, fill),
  fc: ax__style_get(style, fill_color),
  sl: ax__style_get(style, showlegend),
  hi: ax__style_get(style, hoverinfo),
  ht: ax__style_get(style, hover_text),
  if ax__style_get(style, legendgroup) # false then
    parts: endcons(sconcat("\"legendgroup\":",
      ax__json_string(ax__style_get(style, legendgroup))), parts),
  if sl = true or sl = false then
    parts: endcons(sconcat("\"showlegend\":", if sl then "true" else "false"), parts),
  if hi # false then
    parts: endcons(sconcat("\"hoverinfo\":", ax__json_string(hi)), parts),
  if stringp(ht) then
    parts: endcons(sconcat("\"hovertext\":", ax__json_string(ht)), parts)
  else if listp(ht) then
    parts: endcons(sconcat("\"hovertext\":", ax__string_list_to_json(ht)), parts),
  if op_val # false and op_val # 1.0 then
    parts: endcons(sconcat("\"opacity\":", string(float(op_val))), parts),
  if nm # false then
    parts: endcons(sconcat("\"name\":", ax__json_string(nm)), parts)
  else if auto_name # false then
    parts: endcons(sconcat("\"name\":", ax__json_string(auto_name)), parts),
  if fl # false then
    parts: endcons(sconcat("\"fill\":", ax__json_string(fl)), parts),
  if fc # false then
    parts: endcons(sconcat("\"fillcolor\":", ax__json_string(ax__color_to_css(fc))), parts),
  parts)$

/* 2D explicit trace: explicit(expr, var, lo, hi) → scatter line */
ax__trace_explicit_2d(obj, style) := block(
  [a, expr, var, lo, hi, n, data, xs, ys, parts, heads, ff, gtrace],
  a: args(obj),
  expr: a[1], var: a[2], lo: a[3], hi: a[4],
  n: ax__style_get(style, nticks),
  if n = false then n: 500,
  data: ax__sample_1d(expr, var, lo, hi, n),
  xs: data[1], ys: data[2],
  /* filled_func (draw-compatible): true fills to y = 0; an expression g
     fills between f and g via an invisible g trace + fill "tonexty" */
  ff: ax__style_get(style, filled_func),
  gtrace: false,
  if ff = true then
    style: ax__style_set(style, fill, "tozeroy")
  else if ff # false then (
    gtrace: sconcat("{\"x\":", ax__float_list_to_json(xs),
      ",\"y\":", ax__float_list_to_json(ax__sample_1d(ff, var, lo, hi, n)[2]),
      ",\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"width\":0}",
      ",\"showlegend\":false,\"hoverinfo\":\"skip\"}"),
    style: ax__style_set(style, fill, "tonexty")
  ),
  [xs, ys]: ax__decorate(xs, ys, style),
  heads: ax__curve_heads(xs, ys, style),
  parts: [
    sconcat("\"x\":", ax__float_list_to_json(heads[1])),
    sconcat("\"y\":", ax__float_list_to_json(heads[2])),
    "\"type\":\"scatter\"",
    sconcat("\"mode\":", ax__json_string(heads[3])),
    sconcat("\"line\":", ax__curve_line_json(style, heads))
  ],
  parts: append(parts, heads[4], ax__build_trace_style(style, string(expr))),
  if gtrace = false then sconcat("{", simplode(parts, ","), "}")
  else [gtrace, sconcat("{", simplode(parts, ","), "}")])$

/* 2D parametric trace: parametric(xexpr, yexpr, tvar, tlo, thi) → scatter line */
ax__trace_parametric_2d(obj, style) := block(
  [a, xexpr, yexpr, tvar, tlo, thi, n, data, heads, parts],
  a: args(obj),
  xexpr: a[1], yexpr: a[2], tvar: a[3], tlo: a[4], thi: a[5],
  n: ax__style_get(style, nticks),
  if n = false then n: 500,
  data: ax__sample_parametric_2d(xexpr, yexpr, tvar, tlo, thi, n),
  heads: apply(ax__curve_heads, endcons(style, ax__decorate(data[1], data[2], style))),
  parts: [
    sconcat("\"x\":", ax__float_list_to_json(heads[1])),
    sconcat("\"y\":", ax__float_list_to_json(heads[2])),
    "\"type\":\"scatter\"",
    sconcat("\"mode\":", ax__json_string(heads[3])),
    sconcat("\"line\":", ax__curve_line_json(style, heads))
  ],
  parts: append(parts, heads[4],
    ax__build_trace_style(style, sconcat("(", string(xexpr), ", ", string(yexpr), ")"))),
  sconcat("{", simplode(parts, ","), "}"))$

/* 2D points trace: points(data) → scatter markers
   data can be [[x1,y1],[x2,y2],...] or [y1,y2,...]
   Also supports points(xs, ys) with separate x and y lists/ndarrays */
ax__trace_points_2d(obj, style) := block(
  [a, data, xs, ys, parts],
  a: args(obj),
  if length(a) = 2 then (
    xs: ax__maybe_list(a[1]),
    ys: ax__maybe_list(a[2])
  ) else (
    data: ax__maybe_list(a[1]),
    if listp(first(data)) then (
      xs: map(first, data),
      ys: map(second, data)
    ) else (
      xs: makelist(i, i, 1, length(data)),
      ys: data
    )
  ),
  parts: [
    sconcat("\"x\":", ax__float_list_to_json(ax__check_numeric_data(xs, "points", "x"))),
    sconcat("\"y\":", ax__float_list_to_json(ax__check_numeric_data(ys, "points", "y"))),
    "\"type\":\"scatter\"",
    "\"mode\":\"markers\"",
    sconcat("\"marker\":", ax__build_marker_style(style))
  ],
  parts: append(parts, ax__build_trace_style(style, "points")),
  sconcat("{", simplode(parts, ","), "}"))$

/* 2D lines trace: lines(data) → scatter lines
   data can be [[x1,y1],[x2,y2],...] or [y1,y2,...]
   Also supports lines(xs, ys) with separate x and y lists/ndarrays */
ax__trace_lines_2d(obj, style) := block(
  [a, data, xs, ys, parts, heads],
  a: args(obj),
  if length(a) = 2 then (
    xs: ax__maybe_list(a[1]),
    ys: ax__maybe_list(a[2])
  ) else (
    data: ax__maybe_list(a[1]),
    if listp(first(data)) then (
      xs: map(first, data),
      ys: map(second, data)
    ) else (
      xs: makelist(i, i, 1, length(data)),
      ys: data
    )
  ),
  ax__check_numeric_data(xs, "lines", "x"),
  ax__check_numeric_data(ys, "lines", "y"),
  [xs, ys]: ax__decorate(xs, ys, style),
  heads: ax__curve_heads(xs, ys, style),
  parts: [
    sconcat("\"x\":", ax__float_list_to_json(heads[1])),
    sconcat("\"y\":", ax__float_list_to_json(heads[2])),
    "\"type\":\"scatter\"",
    sconcat("\"mode\":", ax__json_string(heads[3])),
    sconcat("\"line\":", ax__curve_line_json(style, heads))
  ],
  parts: append(parts, heads[4], ax__build_trace_style(style, "lines")),
  sconcat("{", simplode(parts, ","), "}"))$

/* ------------------------------------------------------------------------
 * Annotation objects: label(...) and vector(...) become Plotly layout
 * annotations, not traces (annotations support rotated text and arrows).
 * Their builders return ax__annotations([json, ...]); ax__draw2d_impl
 * collects these into layout.annotations.
 * ------------------------------------------------------------------------ */

ax__annotation_result_p(r) := not atom(r) and op(r) = 'ax__annotations$

/* Shape objects (rectangle, ellipse, hline, vline) likewise return
   ax__shapes([json, ...]), collected into layout.shapes. */
ax__shape_result_p(r) := not atom(r) and op(r) = 'ax__shapes$

/* Results that go into the layout rather than the trace list */
ax__layout_result_p(r) := ax__annotation_result_p(r) or ax__shape_result_p(r)$

/* The layout array a layout result belongs in */
ax__layout_result_key(r) := if ax__annotation_result_p(r) then "annotations" else "shapes"$

/* LAY is the list of layout objects in argument order, each
   [key, jsons, spec]: key "annotations" or "shapes", jsons the items as
   first drawn, and spec false (static) or [inner, style] for an object
   inside animate(...).  The items for KEY, as first drawn: */
ax__layout_items(lay, key) :=
  apply(append, map(second, sublist(lay, lambda([e], e[1] = key))))$

/* The items for KEY at parameter value P: animated objects rebuilt there */
ax__layout_items_at(lay, key, param, p) :=
  apply(append, map(lambda([e],
      if e[3] = false then e[2]
      else first(args(ax__build_trace_2d(subst(p, param, e[3][1]), e[3][2])))),
    sublist(lay, lambda([e], e[1] = key))))$

/* Splice "key":[items] into a layout JSON object string */
ax__layout_add_array(layout_json, key, items) := block([body],
  /* Trim the trailing "}" */
  body: substring(layout_json, 1, slength(layout_json)),
  sconcat(body, ",\"", key, "\":[", simplode(items, ","), "]}"))$

ax__layout_add_annotations(layout_json, anns) :=
  ax__layout_add_array(layout_json, "annotations", anns)$

/* Label font: font_size, font_color (falls back to color), font_family.
   Returns a JSON object string, or false when nothing is set. */
ax__label_font_json(style) := block([parts, sz, fc, fam],
  parts: [],
  sz: ax__style_get(style, font_size),
  fc: ax__style_get(style, font_color),
  if fc = false then fc: ax__style_get(style, color),
  fam: ax__style_get(style, font_family),
  if sz # false then
    parts: endcons(sconcat("\"size\":", ax__float_to_json(sz)), parts),
  if fc # false then
    parts: endcons(sconcat("\"color\":", ax__json_string(ax__color_to_css(fc))), parts),
  if fam # false then
    parts: endcons(sconcat("\"family\":", ax__json_string(fam)), parts),
  if parts = [] then false else sconcat("{", simplode(parts, ","), "}"))$

/* 2D text labels: label([text, x, y], [text, x, y], ...) → annotations.
   Same calling form as the draw package.  label_angle is degrees
   counterclockwise (Plotly's textangle is clockwise, so it is negated). */
ax__trace_label_2d(obj, style) := block(
  [items, xa, ya, ang, ori, off, fontj, op_val, ht, common],
  items: args(obj),
  if items = [] then error("label: expected label([text, x, y], ...)"),
  off: ax__style_get(style, label_offset),
  xa: ax__style_get(style, label_alignment),
  ya: ax__style_get(style, label_valign),
  ang: ax__style_get(style, label_angle),
  ori: ax__style_get(style, label_orientation),
  if ang = false and (ori = 'vertical or ori = "vertical") then ang: 90,
  fontj: ax__label_font_json(style),
  op_val: ax__style_get(style, opacity),
  ht: ax__style_get(style, hover_text),
  common: [],
  if xa # false then
    common: endcons(sconcat("\"xanchor\":", ax__json_string(xa)), common),
  if ya # false then
    common: endcons(sconcat("\"yanchor\":", ax__json_string(ya)), common),
  if ang # false then
    common: endcons(sconcat("\"textangle\":", ax__float_to_json(-ang)), common),
  if off # false then (
    if not (listp(off) and length(off) = 2 and numberp(float(off[1])) and numberp(float(off[2]))) then
      error("label: label_offset must be [dx, dy] in pixels, got:", off),
    common: append(common, [sconcat("\"xshift\":", ax__float_to_json(off[1])),
                            sconcat("\"yshift\":", ax__float_to_json(off[2]))])),
  if fontj # false then
    common: endcons(sconcat("\"font\":", fontj), common),
  if op_val # false and op_val # 1.0 then
    common: endcons(sconcat("\"opacity\":", ax__float_to_json(op_val)), common),
  if stringp(ht) then
    common: endcons(sconcat("\"hovertext\":", ax__json_string(ht)), common),
  funmake('ax__annotations, [map(lambda([it], block([parts],
    if not (listp(it) and length(it) = 3) then
      error("label: each item must be [text, x, y], got:", it),
    ax__check_numeric_data([it[2]], "label", "x"),
    ax__check_numeric_data([it[3]], "label", "y"),
    /* float text, e.g. an animate parameter, shows 3 significant figures */
    parts: [sconcat("\"text\":", ax__json_string(
              if floatnump(it[1]) then ax__format_animate_value(it[1]) else it[1])),
            sconcat("\"x\":", ax__float_to_json(it[2])),
            sconcat("\"y\":", ax__float_to_json(it[3])),
            "\"xref\":\"x\"", "\"yref\":\"y\"", "\"showarrow\":false"],
    sconcat("{", simplode(append(parts, common), ","), "}"))), items)]))$

/* 2D arrow: vector([x, y], [dx, dy]) → annotation arrow from (x, y) to
   (x+dx, y+dy), in data coordinates.  Same calling form as the draw package. */
ax__trace_vector_2d(obj, style) := block(
  [a, p, d, tip, parts, c, lw, hs, hst, hb, op_val, ht],
  a: args(obj),
  if length(a) # 2 or not listp(a[1]) or not listp(a[2])
     or length(a[1]) # 2 or length(a[2]) # 2 then
    error("vector: expected vector([x, y], [dx, dy]), got:", obj),
  p: a[1], d: a[2],
  ax__check_numeric_data(p, "vector", "origin"),
  ax__check_numeric_data(d, "vector", "components"),
  tip: p + d,
  parts: [sconcat("\"x\":", ax__float_to_json(tip[1])),
          sconcat("\"y\":", ax__float_to_json(tip[2])),
          sconcat("\"ax\":", ax__float_to_json(p[1])),
          sconcat("\"ay\":", ax__float_to_json(p[2])),
          "\"xref\":\"x\"", "\"yref\":\"y\"", "\"axref\":\"x\"", "\"ayref\":\"y\"",
          "\"text\":\"\"", "\"showarrow\":true"],
  c: ax__style_get(style, color),
  lw: ax__style_get(style, line_width),
  hs: ax__style_get(style, head_size),
  hst: ax__style_get(style, head_style),
  hb: ax__style_get(style, head_both),
  op_val: ax__style_get(style, opacity),
  ht: ax__style_get(style, hover_text),
  if c # false then
    parts: endcons(sconcat("\"arrowcolor\":", ax__json_string(ax__color_to_css(c))), parts),
  if lw # false then
    parts: endcons(sconcat("\"arrowwidth\":", ax__float_to_json(lw)), parts),
  if hs # false then
    parts: endcons(sconcat("\"arrowsize\":", ax__float_to_json(hs)), parts),
  if hst # false then
    parts: endcons(sconcat("\"arrowhead\":", string(hst)), parts),
  if hb = true then
    parts: endcons("\"arrowside\":\"end+start\"", parts),
  if op_val # false and op_val # 1.0 then
    parts: endcons(sconcat("\"opacity\":", ax__float_to_json(op_val)), parts),
  if stringp(ht) then
    parts: endcons(sconcat("\"hovertext\":", ax__json_string(ht)), parts),
  funmake('ax__annotations, [[sconcat("{", simplode(parts, ","), "}")]]))$

/* 2D filled polygon: polygon([[x1,y1], ...]) or polygon(xs, ys) → scatter
   with fill "toself".  The path is closed automatically.  fill_color sets
   the fill, color/line_width/dash the outline (line_width=0 hides it);
   transparent=true draws the outline only. */
ax__trace_polygon_2d(obj, style) := block([a, data, xs, ys, st, parts],
  a: args(obj),
  if length(a) = 2 then (
    xs: ax__maybe_list(a[1]),
    ys: ax__maybe_list(a[2])
  ) else if length(a) = 1 then (
    data: ax__maybe_list(a[1]),
    if not (listp(data) and data # [] and listp(first(data))) then
      error("polygon: expected polygon([[x1, y1], ...]) or polygon(xs, ys)"),
    xs: map(first, data),
    ys: map(second, data)
  ) else
    error("polygon: expected polygon([[x1, y1], ...]) or polygon(xs, ys)"),
  if length(xs) # length(ys) then
    error("polygon: x and y lists differ in length"),
  if length(xs) < 3 then
    error("polygon: need at least 3 vertices"),
  ax__check_numeric_data(xs, "polygon", "x"),
  ax__check_numeric_data(ys, "polygon", "y"),
  if first(xs) # last(xs) or first(ys) # last(ys) then (
    xs: endcons(first(xs), xs),
    ys: endcons(first(ys), ys)
  ),
  st: ax__style_set(style, fill,
        if ax__style_get(style, transparent) = true then false else "toself"),
  parts: [
    sconcat("\"x\":", ax__float_list_to_json(xs)),
    sconcat("\"y\":", ax__float_list_to_json(ys)),
    "\"type\":\"scatter\"",
    "\"mode\":\"lines\"",
    sconcat("\"line\":", ax__build_line_style(st))
  ],
  parts: append(parts, ax__build_trace_style(st, "polygon")),
  sconcat("{", simplode(parts, ","), "}"))$

/* ------------------------------------------------------------------------
 * Shapes: rectangle, ellipse, hline, vline → Plotly layout shapes.
 * Outline from color / line_width / dash; fill only when fill_color is
 * set (and transparent is not true); layer="below" puts them under the
 * data.  Shapes are not hover targets and never appear in the legend.
 * ------------------------------------------------------------------------ */

/* Common shape style: [line, fillcolor, layer, opacity] JSON parts */
ax__shape_style_parts(style, closed) := block([parts, fc, ly, op_val],
  parts: [sconcat("\"line\":", ax__build_line_style(style))],
  fc: ax__style_get(style, fill_color),
  if closed and fc # false and ax__style_get(style, transparent) # true then
    parts: endcons(sconcat("\"fillcolor\":", ax__json_string(ax__color_to_css(fc))), parts),
  ly: ax__style_get(style, layer),
  if ly # false then
    parts: endcons(sconcat("\"layer\":", ax__json_string(ly)), parts),
  op_val: ax__style_get(style, opacity),
  if op_val # false and op_val # 1.0 then
    parts: endcons(sconcat("\"opacity\":", ax__float_to_json(op_val)), parts),
  parts)$

ax__shape_json(head_parts, style, closed) :=
  sconcat("{", simplode(append(head_parts, ax__shape_style_parts(style, closed)), ","), "}")$

/* rectangle([x1, y1], [x2, y2]) — opposite corners (draw form) */
ax__shape_rectangle(obj, style) := block([a],
  a: args(obj),
  if length(a) # 2 or not listp(a[1]) or not listp(a[2])
     or length(a[1]) # 2 or length(a[2]) # 2 then
    error("rectangle: expected rectangle([x1, y1], [x2, y2]), got:", obj),
  ax__check_numeric_data(append(a[1], a[2]), "rectangle", "corner"),
  funmake('ax__shapes, [[ax__shape_json(
    ["\"type\":\"rect\"", "\"xref\":\"x\"", "\"yref\":\"y\"",
     sconcat("\"x0\":", ax__float_to_json(a[1][1])), sconcat("\"y0\":", ax__float_to_json(a[1][2])),
     sconcat("\"x1\":", ax__float_to_json(a[2][1])), sconcat("\"y1\":", ax__float_to_json(a[2][2]))],
    style, true)]]))$

/* ellipse(xc, yc, a, b) — full ellipse; ellipse(xc, yc, a, b, ang1, ang2)
   — elliptic sector from ang1 sweeping ang2 degrees (draw form).  A sweep
   of 360° or more is a full ellipse. */
ax__shape_ellipse(obj, style) := block([a, xc, yc, ra, rb, a1, sw, n, pts],
  a: args(obj),
  if length(a) # 4 and length(a) # 6 then
    error("ellipse: expected ellipse(xc, yc, a, b) or ellipse(xc, yc, a, b, ang1, ang2), got:", obj),
  ax__check_numeric_data(a, "ellipse", "argument"),
  [xc, yc, ra, rb]: map(lambda([v], float(v)), firstn(a, 4)),
  if length(a) = 4 or abs(float(a[6])) >= 360 then
    return(funmake('ax__shapes, [[ax__shape_json(
      ["\"type\":\"circle\"", "\"xref\":\"x\"", "\"yref\":\"y\"",
       sconcat("\"x0\":", ax__float_to_json(xc - ra)), sconcat("\"y0\":", ax__float_to_json(yc - rb)),
       sconcat("\"x1\":", ax__float_to_json(xc + ra)), sconcat("\"y1\":", ax__float_to_json(yc + rb))],
      style, true)]])),
  a1: float(a[5]) * %pi / 180, sw: float(a[6]) * %pi / 180,
  n: max(2, ceiling(abs(float(a[6])) / 3)),
  pts: makelist(block([t: a1 + sw * i / n],
         sconcat(ax__float_to_json(xc + ra * cos(t)), ",", ax__float_to_json(yc + rb * sin(t)))),
       i, 0, n),
  funmake('ax__shapes, [[ax__shape_json(
    ["\"type\":\"path\"", "\"xref\":\"x\"", "\"yref\":\"y\"",
     sconcat("\"path\":\"M ", ax__float_to_json(xc), ",", ax__float_to_json(yc),
             " L ", simplode(pts, " L "), " Z\"")],
    style, true)]]))$

/* hline(y1, y2, ...) / vline(x1, x2, ...) — lines across the whole plot */
ax__shape_hvline(obj, style) := block([a, horiz],
  a: args(obj),
  horiz: is(op(obj) = hline),
  if a = [] then error(sconcat(op(obj), ": expected at least one position")),
  ax__check_numeric_data(a, string(op(obj)), "position"),
  funmake('ax__shapes, [map(lambda([v], block([fv: ax__float_to_json(v)],
    ax__shape_json(
      if horiz then
        ["\"type\":\"line\"", "\"xref\":\"paper\"", "\"x0\":0", "\"x1\":1",
         "\"yref\":\"y\"", sconcat("\"y0\":", fv), sconcat("\"y1\":", fv)]
      else
        ["\"type\":\"line\"", "\"yref\":\"paper\"", "\"y0\":0", "\"y1\":1",
         "\"xref\":\"x\"", sconcat("\"x0\":", fv), sconcat("\"x1\":", fv)],
      style, false))), a)]))$

/* Whitespace characters trimmed from raw JSON strings */
ax__ws : sconcat(" ", ascii(9), ascii(10), ascii(13))$

/* Check that S looks like a JSON object string "{...}"; return it trimmed */
ax__raw_json_object(s, who) := block([t],
  if not stringp(s) then error(sconcat(who, ": expected a JSON object string, got:"), s),
  t: strim(ax__ws, s),
  if slength(t) < 2 or charat(t, 1) # "{" or charat(t, slength(t)) # "}" then
    error(sconcat(who, ": expected a JSON object string {...}, got:"), s),
  t)$

/* Escape hatch: ax_trace("{\"type\":\"scatter\", ...}") emits the given
   Plotly trace JSON verbatim.  Style options do not apply. */
ax__trace_raw(obj) := block([a: args(obj)],
  if length(a) # 1 then error("ax_trace: expected ax_trace(json_string)"),
  ax__raw_json_object(a[1], "ax_trace"))$

/* Arrowheads on curves (head_end, head_start, head_count, head_direction).
   Uses Plotly arrow markers with angleref "previous", so each head points
   along the segment from the previous data point in screen space (correct
   under any aspect ratio).  Marker size is 0 except at head points.
   head_direction="tangent" (default) uses the curve's own previous point.
   head_direction="chord" points each head along the overall direction of
   the curve: it inserts a point a hair behind the head on the chord from a
   reference point one head-spacing of arc length back (the whole curve for
   a lone head_end), so wavy curves get heads along their mean direction.
   head_start prepends such a point ahead of the first point so the first
   head has a "previous" point and points backwards.
   Returns [xs, ys, mode, extra_parts]. */
/* Path decorations, as in TikZ: decoration="snake" (sine wave) or "zigzag"
   replaces a curve by a wave that follows it, offset along the curve's
   normal in data units (so it looks right with aspect_ratio=true).  The
   first decoration_pre and last decoration_post of length stay straight;
   the wavelength is adjusted so a whole number of waves fits, so the wave
   ends back on the path.  Runs separated by gaps are decorated separately.
   Returns [xs, ys]. */
ax__decorate(xs, ys, style) := block([deco, kind, runs: [], run: [], out: []],
  deco: ax__style_get(style, decoration),
  if deco = false or deco = 'none or deco = "none" then return([xs, ys]),
  if member(deco, ['snake, "snake"]) then kind: "snake"
  else if member(deco, ['zigzag, "zigzag"]) then kind: "zigzag"
  else error("decoration: expected \"snake\" or \"zigzag\", got:", deco),
  for p in map("[", xs, ys) do block([x: float(p[1]), y: float(p[2])],
    if numberp(x) and numberp(y) then run: cons([x, y], run)
    else (if run # [] then runs: cons(reverse(run), runs), run: [])),
  if run # [] then runs: cons(reverse(run), runs),
  runs: reverse(runs),
  /* the curve's end heads sit on the first and last runs only */
  for k: 1 thru length(runs) do block([st: style],
    if k > 1 then st: ax__style_set(st, head_start, false),
    if k < length(runs) then st: ax__style_set(st, head_end, false),
    if out # [] then out: endcons([false, false], out),
    out: append(out, ax__decorate_run(runs[k], kind, st))),
  [map(first, out), map(second, out)])$

/* Positive number option, or `dflt` when unset */
ax__decoration_length(style, key, dflt) := block([v: ax__style_get(style, key)],
  if v = false then dflt
  else block([f: float(v)],
    if not numberp(f) or f < 0 then
      error(sconcat(string(key), ": expected a non-negative number, got:"), v),
    f))$

ax__decorate_run(pts, kind, style) := block(
  [n, xa, ya, cum, L, nx, ny, wl, amp, pre, post, D, m, w, per, tol, ents,
   seg: 0, wave, before: [], mid: [], after: []],
  n: length(pts),
  if n < 2 then return(pts),
  xa: fillarray(make_array(any, n), map(first, pts)),
  ya: fillarray(make_array(any, n), map(second, pts)),
  cum: make_array(any, n),
  cum[0]: 0.0,
  for i: 1 thru n - 1 do
    cum[i]: cum[i - 1] + sqrt((xa[i] - xa[i - 1])^2 + (ya[i] - ya[i - 1])^2),
  L: cum[n - 1],
  if L <= 0 then return(pts),
  /* unit left normal of each segment; a zero-length segment borrows a neighbour's */
  nx: make_array(any, n - 1), ny: make_array(any, n - 1),
  for k: 0 thru n - 2 do block([dx: xa[k + 1] - xa[k], dy: ya[k + 1] - ya[k], d],
    d: sqrt(dx^2 + dy^2),
    if d > 0 then (nx[k]: -dy / d, ny[k]: dx / d) else (nx[k]: false, ny[k]: false)),
  for k: 1 thru n - 2 do if nx[k] = false then (nx[k]: nx[k - 1], ny[k]: ny[k - 1]),
  for k: n - 3 step -1 thru 0 do if nx[k] = false then (nx[k]: nx[k + 1], ny[k]: ny[k + 1]),
  wl:   ax__decoration_length(style, decoration_wavelength, L / 10),
  if wl <= 0 then error("decoration_wavelength: must be positive"),
  amp:  ax__decoration_length(style, decoration_amplitude, wl / 4),
  pre:  ax__decoration_length(style, decoration_pre,
          if ax__style_get(style, head_start) = true then wl / 2 else 0.0),
  post: ax__decoration_length(style, decoration_post,
          if ax__style_get(style, head_end) = true then wl / 2 else 0.0),
  D: L - pre - post,
  if D <= 0 then return(pts),
  m: max(1, round(D / wl)),
  w: D / m,
  per: if kind = "snake" then 16 else 4,
  tol: 1e-9 * L,
  /* offset along the normal at arc length s */
  wave: lambda([s, j], block([f],
    /* phase in the current wave; exact for the wave's own samples (index j),
       so the wave starts and ends exactly on the path */
    if j # false then f: float(mod(j, per) / per)
    else (f: (s - pre) / w, f: f - floor(f)),
    if kind = "snake" then amp * sin(2 * float(%pi) * f)
    else amp * (if f < 0.25 then 4 * f else if f < 0.75 then 2 - 4 * f else 4 * f - 4))),
  /* wave samples [s, -1], plus the path's own vertices [s, i] inside the
     decorated part so the wave follows bends between samples */
  ents: makelist([pre + w * j / per, -1, j], j, 0, per * m),
  for i: 0 thru n - 1 do
    if cum[i] > pre + tol and cum[i] < pre + D - tol then ents: cons([cum[i], i, false], ents),
  ents: sort(ents, lambda([a, b], is(a[1] < b[1]))),
  for e in ents do block([s: e[1], i: e[2], px, py, qx, qy, off, d],
    if i >= 0 then (
      px: xa[i], py: ya[i],
      qx: nx[max(i - 1, 0)] + nx[min(i, n - 2)],
      qy: ny[max(i - 1, 0)] + ny[min(i, n - 2)],
      d: sqrt(qx^2 + qy^2),
      if d > 1e-12 then (qx: qx / d, qy: qy / d)
      else (qx: nx[max(i - 1, 0)], qy: ny[max(i - 1, 0)])
    ) else block([seglen, t],
      while seg < n - 2 and cum[seg + 1] < s do seg: seg + 1,
      seglen: cum[seg + 1] - cum[seg],
      t: if seglen > 0 then min(1.0, max(0.0, (s - cum[seg]) / seglen)) else 0.0,
      px: xa[seg] + t * (xa[seg + 1] - xa[seg]),
      py: ya[seg] + t * (ya[seg + 1] - ya[seg]),
      qx: nx[seg], qy: ny[seg]),
    off: wave(s, e[3]),
    mid: cons([px + off * qx, py + off * qy], mid)),
  for i: 0 thru n - 1 do (
    if cum[i] < pre - tol then before: cons([xa[i], ya[i]], before),
    if cum[i] > pre + D + tol then after: cons([xa[i], ya[i]], after)),
  append(reverse(before), reverse(mid), reverse(after)))$

ax__curve_heads(xs, ys, style) := block(
  [he, hs0, hc, chord, n, fx, fy, fxa, fya, cuma, segs, total, look, targets,
   heads, qassoc, q0, eps: 1e-4, lw, hsz, sz, c, ox, oy, osz, k, q, mparts],
  he:  ax__style_get(style, head_end) = true,
  hs0: ax__style_get(style, head_start) = true,
  hc:  ax__style_get(style, head_count),
  if not integerp(hc) then hc: 0,
  chord: member(ax__style_get(style, head_direction), ['chord, "chord"]),
  n: length(xs),
  if (not he and not hs0 and hc <= 0) or n < 2 then return([xs, ys, "lines", []]),
  fx: map(lambda([v], block([f: float(v)], if numberp(f) then f else false)), xs),
  fy: map(lambda([v], block([f: float(v)], if numberp(f) then f else false)), ys),
  fxa: fillarray(make_array(any, n), fx),
  fya: fillarray(make_array(any, n), fy),
  /* segs[k] = length of segment k -> k+1 (0 across gaps);
     cuma[k-1] = arc length from the first point to point k */
  segs: map(lambda([x1, y1, x2, y2],
              if x1 = false or y1 = false or x2 = false or y2 = false then 0.0
              else sqrt((x2 - x1)^2 + (y2 - y1)^2)),
            rest(fx, -1), rest(fy, -1), rest(fx), rest(fy)),
  total: lsum(s, s, segs),
  block([acc: 0.0, r: [0.0]],
    for s in segs do (acc: acc + s, r: cons(acc, r)),
    cuma: fillarray(make_array(any, n), reverse(r))),
  heads: if he then [n] else [],
  if hc > 0 and total > 0 then (
    targets: makelist(j * total / (hc + 1), j, 1, hc),
    block([acc: 0.0], k: 1,
      for s in segs do (
        k: k + 1,
        acc: acc + s,
        while targets # [] and acc >= first(targets) do (
          heads: cons(k, heads),
          targets: rest(targets))))
  ),
  look: total / (hc + 1),
  /* chord mode: a point just behind head i on the chord from point j, the
     last point at least `look` arc length before it */
  qassoc: [],
  if chord and total > 0 then
    for i in heads do block([j: i - 1],
      while j > 1 and cuma[j - 1] > cuma[i - 1] - look do j: j - 1,
      if fxa[i - 1] # false and fya[i - 1] # false and fxa[j - 1] # false and fya[j - 1] # false then
        qassoc: cons([i, [fxa[i - 1] - eps * (fxa[i - 1] - fxa[j - 1]),
                          fya[i - 1] - eps * (fya[i - 1] - fya[j - 1])]], qassoc)),
  /* head_start: a point just ahead of the first point, toward point 2
     (tangent) or the first point at least `look` along the curve (chord) */
  q0: false,
  if hs0 then block([j: 2],
    if chord and total > 0 then
      while j < n and cuma[j - 1] < look do j: j + 1,
    if fxa[0] # false and fya[0] # false and fxa[j - 1] # false and fya[j - 1] # false then
      q0: [fxa[0] + eps * (fxa[j - 1] - fxa[0]), fya[0] + eps * (fya[j - 1] - fya[0])]),
  lw:  ax__style_get(style, line_width), if not numberp(lw) then lw: 2,
  hsz: ax__style_get(style, head_size),  if not numberp(hsz) then hsz: 1,
  sz:  float(hsz * (3 * lw + 6)),
  /* one pass: emit inserted points and per-point marker sizes */
  ox: [], oy: [], osz: [],
  if q0 # false then (ox: [q0[1]], oy: [q0[2]], osz: [0]),
  k: 0,
  for p in map("[", xs, ys) do (
    k: k + 1,
    q: assoc(k, qassoc),
    if q # false then (ox: cons(q[1], ox), oy: cons(q[2], oy), osz: cons(0, osz)),
    ox: cons(p[1], ox), oy: cons(p[2], oy),
    osz: cons(if member(k, heads) or (k = 1 and q0 # false) then sz else 0, osz)),
  mparts: ["\"symbol\":\"arrow\"", "\"angleref\":\"previous\"",
           sconcat("\"size\":", ax__float_list_to_json(reverse(osz)))],
  /* an explicit line color doesn't propagate to markers in Plotly */
  c: ax__style_get(style, color),
  if c # false then
    mparts: endcons(sconcat("\"color\":", ax__json_string(ax__color_to_css(c))), mparts),
  /* no outline: Plotly's default marker outline cuts a light rim into the line;
     opacity 1: an array-valued size makes Plotly treat the trace as a bubble
     chart and fade markers to 0.7 (trace-level opacity still applies) */
  mparts: append(mparts, ["\"line\":{\"width\":0}", "\"opacity\":1"]),
  [reverse(ox), reverse(oy), "lines+markers", [sconcat("\"marker\":{", simplode(mparts, ","), "}")]])$

/* Line style for a curve built with ax__curve_heads.  With heads, Plotly's
   line simplification (on by default) splits a lines+markers trace into
   short paths and can drop a piece next to a head, leaving a visible gap;
   simplify=false keeps the line whole. */
ax__curve_line_json(style, heads) := block([s: ax__build_line_style(style)],
  if heads[3] = "lines" then s
  else if s = "{}" then "{\"simplify\":false}"
  else sconcat("{\"simplify\":false,", substring(s, 2)))$

/* ------------------------------------------------------------------------
 * Layout helpers shared by the 2D, 3D and polar layout builders
 * ------------------------------------------------------------------------ */

ax__autosize_p(opts) := is(ax__layout_opt_value(opts, autosize, false) = true)$

/* legend_position: "top-right" | "top-left" | "bottom-right" | "bottom-left"
   (inside the plot), "top" | "bottom" (outside, horizontal), "right" (Plotly's
   default), or [x, y] in paper coordinates.  legend_orientation: "h" / "v". */
ax__legend_json(lp, lo, [lt]) := block([p, s, spec],
  p: [],
  if lt # [] and first(lt) # false then
    p: endcons(sconcat("\"title\":{\"text\":", ax__json_string(first(lt)), "}"), p),
  if lp # false then (
    if listp(lp) then (
      if length(lp) # 2 then error("legend_position: expected a name or [x, y], got", lp),
      spec: [lp[1], lp[2], false, false]
    ) else (
      s: if stringp(lp) then lp else ssubst("-", "_", sconcat(lp)),
      spec: if s = "top-right" then [0.99, 0.99, "right", "top"]
        else if s = "top-left" then [0.01, 0.99, "left", "top"]
        else if s = "bottom-right" then [0.99, 0.01, "right", "bottom"]
        else if s = "bottom-left" then [0.01, 0.01, "left", "bottom"]
        else if s = "top" then [0.5, 1.02, "center", "bottom"]
        else if s = "bottom" then [0.5, -0.12, "center", "top"]
        else if s = "right" then [1.02, 1, "left", "top"]
        else error("legend_position: unknown position", lp),
      if lo = false and (s = "top" or s = "bottom") then lo: "h"
    ),
    p: endcons(sconcat("\"x\":", ax__float_to_json(spec[1])), p),
    p: endcons(sconcat("\"y\":", ax__float_to_json(spec[2])), p),
    if spec[3] # false then p: endcons(sconcat("\"xanchor\":", ax__json_string(spec[3])), p),
    if spec[4] # false then p: endcons(sconcat("\"yanchor\":", ax__json_string(spec[4])), p)
  ),
  if lo # false then
    p: endcons(sconcat("\"orientation\":",
      ax__json_string(if lo = 'horizontal or lo = "horizontal" or lo = h or lo = "h" then "h" else "v")), p),
  sconcat("\"legend\":{", simplode(p, ","), "}"))$

/* Layout parts common to every layout builder: autosize, legend, colorway */
ax__common_layout_parts(opts) := block([parts, lp, lo, lt, cw],
  parts: [],
  if ax__autosize_p(opts) then parts: endcons("\"autosize\":true", parts),
  lp: ax__layout_opt_value(opts, legend_position, false),
  lo: ax__layout_opt_value(opts, legend_orientation, false),
  lt: ax__layout_opt_value(opts, legend_title, false),
  if lp # false or lo # false or lt # false then
    parts: endcons(ax__legend_json(lp, lo, lt), parts),
  /* colorway: the colour sequence for traces without an explicit color */
  cw: ax__layout_opt_value(opts, colorway, false),
  if cw # false then (
    if not listp(cw) then error("colorway: expected a list of colours, got", cw),
    parts: endcons(sconcat("\"colorway\":", ax__string_list_to_json(map(ax__color_to_css, cw))), parts)
  ),
  parts)$

/* theme="light" (default) or "dark" → [background, grid, axis line, zero
   line, text] colours.  Text is false for light, keeping Plotly's default. */
ax__theme_colors(opts) := block([t: ax__layout_opt_value(opts, theme, "light")],
  if member(t, ['light, "light"]) then ["white", "#ddd", "#ddd", "black", false]
  else if member(t, ['dark, "dark"]) then ["#111111", "#333333", "#555555", "#aaaaaa", "#e8e8e8"]
  else error("theme: expected \"light\" or \"dark\", got", t))$

/* Grid / axis-line (and zero-line) colours for one axis */
ax__theme_axis_json(tc, zero) :=
  sconcat("\"gridcolor\":\"", tc[2], "\",\"linecolor\":\"", tc[3], "\",\"linewidth\":1",
          if zero then sconcat(",\"zerolinecolor\":\"", tc[4], "\",\"zerolinewidth\":1") else "")$

/* Text colour for a dark theme, plus template defaults for annotation arrows
   and shape outlines, which Plotly otherwise draws dark grey on any background */
ax__theme_text_parts(tc) :=
  if tc[5] = false then []
  else [sconcat("\"font\":{\"color\":\"", tc[5], "\"}"),
        sconcat("\"template\":{\"layout\":{\"annotationdefaults\":{\"arrowcolor\":\"", tc[5],
                "\"},\"shapedefaults\":{\"line\":{\"color\":\"", tc[5], "\"}}}}")]$

/* title="..." plus title_font_size, title_x (0–1, paper) and
   title_align ("left" / "center" / "right", the anchor at title_x) */
ax__title_json(text, opts) := block([p, fs, tx, ta],
  p: [sconcat("\"text\":", ax__json_string(text))],
  fs: ax__layout_opt_value(opts, title_font_size, false),
  tx: ax__layout_opt_value(opts, title_x, false),
  ta: ax__layout_opt_value(opts, title_align, false),
  if fs # false then p: endcons(sconcat("\"font\":{\"size\":", ax__float_to_json(fs), "}"), p),
  if tx # false then p: endcons(sconcat("\"x\":", ax__float_to_json(tx)), p),
  if ta # false then p: endcons(sconcat("\"xanchor\":", ax__json_string(ta)), p),
  sconcat("\"title\":{", simplode(p, ","), "}"))$

/* layout_raw="{...}": append the given keys to the layout JSON.  Later keys
   win when JSON is parsed, so these override ax-plots' own settings (except
   annotations from label/vector, which are spliced in afterwards). */
ax__layout_merge_raw(layout_json, raw) := block([t, inner],
  if raw = false then return(layout_json),
  t: ax__raw_json_object(raw, "layout_raw"),
  inner: strim(ax__ws, substring(t, 2, slength(t))),
  if inner = "" then return(layout_json),
  sconcat(substring(layout_json, 1, slength(layout_json)), ",", inner, "}"))$

/* 3D lines trace: lines(data) → scatter3d lines
   data is [[x1,y1,z1],[x2,y2,z2],...]
   Also supports lines(xs, ys, zs) with separate lists/ndarrays */
ax__trace_lines_3d(obj, style) := block(
  [a, data, xs, ys, zs, parts],
  a: args(obj),
  if length(a) = 3 then (
    xs: ax__maybe_list(a[1]),
    ys: ax__maybe_list(a[2]),
    zs: ax__maybe_list(a[3])
  ) else (
    data: ax__maybe_list(a[1]),
    xs: map(first, data),
    ys: map(second, data),
    zs: map(third, data)
  ),
  parts: [
    sconcat("\"x\":", ax__float_list_to_json(ax__check_numeric_data(xs, "lines", "x"))),
    sconcat("\"y\":", ax__float_list_to_json(ax__check_numeric_data(ys, "lines", "y"))),
    sconcat("\"z\":", ax__float_list_to_json(ax__check_numeric_data(zs, "lines", "z"))),
    "\"type\":\"scatter3d\"",
    "\"mode\":\"lines\"",
    sconcat("\"line\":", ax__build_line_style(style))
  ],
  parts: append(parts, ax__build_trace_style(style, "lines")),
  sconcat("{", simplode(parts, ","), "}"))$

/* 2D implicit trace: implicit(eqn, xvar, xlo, xhi, yvar, ylo, yhi) → contour at 0 */
ax__trace_implicit_2d(obj, style) := block(
  [a, eqn, xvar, xlo, xhi, yvar, ylo, yhi, n, data, xs, ys, zmat, parts, c],
  a: args(obj),
  eqn: a[1], xvar: a[2], xlo: a[3], xhi: a[4], yvar: a[5], ylo: a[6], yhi: a[7],
  n: ax__style_get(style, nticks),
  if n = false or n > 200 then n: 100, /* sensible default for 2D grid */
  data: ax__sample_implicit_2d(eqn, xvar, xlo, xhi, yvar, ylo, yhi, n),
  xs: data[1], ys: data[2], zmat: data[3],
  c: ax__style_get(style, color),
  parts: [
    sconcat("\"x\":", ax__float_list_to_json(xs)),
    sconcat("\"y\":", ax__float_list_to_json(ys)),
    sconcat("\"z\":", ax__float_matrix_to_json(zmat)),
    "\"type\":\"contour\"",
    "\"showscale\":false",
    "\"autocontour\":false",
    "\"contours\":{\"start\":0,\"end\":0,\"size\":1,\"coloring\":\"none\"}"
  ],
  if c # false then
    parts: endcons(sconcat("\"line\":{\"color\":", ax__json_string(ax__color_to_css(c)), ",\"width\":2}"), parts)
  else
    parts: endcons("\"line\":{\"color\":\"#1f77b4\",\"width\":2}", parts),
  parts: append(parts, ax__build_trace_style(style, string(eqn))),
  sconcat("{", simplode(parts, ","), "}"))$

/* 3D explicit trace: explicit(expr, xvar, xlo, xhi, yvar, ylo, yhi) → surface */
ax__trace_explicit_3d(obj, style) := block(
  [a, expr, xvar, xlo, xhi, yvar, ylo, yhi, n, data, xs, ys, zmat, parts, cs],
  a: args(obj),
  expr: a[1], xvar: a[2], xlo: a[3], xhi: a[4], yvar: a[5], ylo: a[6], yhi: a[7],
  n: ax__style_get(style, nticks),
  if n = false or n > 200 then n: 50, /* 50x50 grid for 3D */
  data: ax__sample_2d(expr, xvar, xlo, xhi, yvar, ylo, yhi, n, n),
  xs: data[1], ys: data[2], zmat: data[3],
  cs: ax__style_get(style, colorscale),
  parts: [
    sconcat("\"x\":", ax__float_list_to_json(xs)),
    sconcat("\"y\":", ax__float_list_to_json(ys)),
    sconcat("\"z\":", ax__float_matrix_to_json(zmat)),
    "\"type\":\"surface\""
  ],
  if cs # false then
    parts: endcons(sconcat("\"colorscale\":", ax__json_string(cs)), parts),
  parts: append(parts, ax__build_trace_style(style, string(expr))),
  sconcat("{", simplode(parts, ","), "}"))$

/* 3D points trace: points(data) → scatter3d markers
   data is [[x1,y1,z1],[x2,y2,z2],...]
   Also supports points(xs, ys, zs) with separate lists/ndarrays */
ax__trace_points_3d(obj, style) := block(
  [a, data, xs, ys, zs, parts],
  a: args(obj),
  if length(a) = 3 then (
    xs: ax__maybe_list(a[1]),
    ys: ax__maybe_list(a[2]),
    zs: ax__maybe_list(a[3])
  ) else (
    data: ax__maybe_list(a[1]),
    xs: map(first, data),
    ys: map(second, data),
    zs: map(third, data)
  ),
  parts: [
    sconcat("\"x\":", ax__float_list_to_json(ax__check_numeric_data(xs, "points", "x"))),
    sconcat("\"y\":", ax__float_list_to_json(ax__check_numeric_data(ys, "points", "y"))),
    sconcat("\"z\":", ax__float_list_to_json(ax__check_numeric_data(zs, "points", "z"))),
    "\"type\":\"scatter3d\"",
    "\"mode\":\"markers\"",
    sconcat("\"marker\":", ax__build_marker_style(style))
  ],
  parts: append(parts, ax__build_trace_style(style, "points")),
  sconcat("{", simplode(parts, ","), "}"))$

/* 3D parametric curve: parametric(x(t), y(t), z(t), t, t0, tf) → scatter3d lines */
ax__trace_parametric_3d(obj, style) := block(
  [a, xexpr, yexpr, zexpr, tvar, tlo, thi, n, data, xs, ys, zs, parts],
  a: args(obj),
  xexpr: a[1], yexpr: a[2], zexpr: a[3], tvar: a[4], tlo: a[5], thi: a[6],
  n: ax__style_get(style, nticks),
  if n = false then n: 500,
  data: ax__sample_parametric_3d(xexpr, yexpr, zexpr, tvar, tlo, thi, n),
  xs: data[1], ys: data[2], zs: data[3],
  parts: [
    sconcat("\"x\":", ax__float_list_to_json(xs)),
    sconcat("\"y\":", ax__float_list_to_json(ys)),
    sconcat("\"z\":", ax__float_list_to_json(zs)),
    "\"type\":\"scatter3d\"",
    "\"mode\":\"lines\"",
    sconcat("\"line\":", ax__build_line_style(style))
  ],
  parts: append(parts, ax__build_trace_style(style,
    sconcat("(", string(xexpr), ", ", string(yexpr), ", ", string(zexpr), ")"))),
  sconcat("{", simplode(parts, ","), "}"))$

/* 3D parametric surface: parametric_surface(x(u,v), y(u,v), z(u,v), u, u0, u1, v, v0, v1) → surface */
ax__trace_parametric_surface_3d(obj, style) := block(
  [a, xexpr, yexpr, zexpr, uvar, ulo, uhi, vvar, vlo, vhi, n, data, xmat, ymat, zmat, parts, cs],
  a: args(obj),
  if length(a) # 9 then
    error("parametric_surface requires 9 arguments: parametric_surface(x(u,v), y(u,v), z(u,v), u, u0, u1, v, v0, v1)"),
  xexpr: a[1], yexpr: a[2], zexpr: a[3],
  uvar: a[4], ulo: a[5], uhi: a[6],
  vvar: a[7], vlo: a[8], vhi: a[9],
  n: ax__style_get(style, nticks),
  if n = false or n > 200 then n: 50,
  data: ax__sample_parametric_surface(xexpr, yexpr, zexpr, uvar, ulo, uhi, vvar, vlo, vhi, n, n),
  xmat: data[1], ymat: data[2], zmat: data[3],
  cs: ax__style_get(style, colorscale),
  parts: [
    sconcat("\"x\":", ax__float_matrix_to_json(xmat)),
    sconcat("\"y\":", ax__float_matrix_to_json(ymat)),
    sconcat("\"z\":", ax__float_matrix_to_json(zmat)),
    "\"type\":\"surface\""
  ],
  if cs # false then
    parts: endcons(sconcat("\"colorscale\":", ax__json_string(cs)), parts),
  parts: append(parts, ax__build_trace_style(style,
    sconcat("(", string(xexpr), ", ", string(yexpr), ", ", string(zexpr), ")"))),
  sconcat("{", simplode(parts, ","), "}"))$

/* 3D implicit surface: implicit(eqn, x, x0, x1, y, y0, y1, z, z0, z1) → isosurface */
ax__trace_implicit_3d(obj, style) := block(
  [a, eqn, fexpr, xvar, xlo, xhi, yvar, ylo, yhi, zvar, zlo, zhi,
   n, data, xs, ys, zs, vals, parts, cs, op_val],
  a: args(obj),
  if length(a) # 10 then
    error("implicit (3D) requires 10 arguments: implicit(eqn, x, x0, x1, y, y0, y1, z, z0, z1)"),
  eqn: a[1],
  xvar: a[2], xlo: a[3], xhi: a[4],
  yvar: a[5], ylo: a[6], yhi: a[7],
  zvar: a[8], zlo: a[9], zhi: a[10],
  /* Convert equation lhs=rhs to lhs-rhs */
  if not atom(eqn) and op(eqn) = "=" then fexpr: lhs(eqn) - rhs(eqn)
  else fexpr: eqn,
  n: ax__style_get(style, nticks),
  if n = false or n > 50 then n: 20, /* 20^3 = 8000 evaluations */
  data: ax__sample_3d(fexpr, xvar, xlo, xhi, yvar, ylo, yhi, zvar, zlo, zhi, n),
  xs: data[1], ys: data[2], zs: data[3], vals: data[4],
  cs: ax__style_get(style, colorscale),
  op_val: ax__style_get(style, opacity),
  parts: [
    sconcat("\"x\":", ax__float_list_to_json(xs)),
    sconcat("\"y\":", ax__float_list_to_json(ys)),
    sconcat("\"z\":", ax__float_list_to_json(zs)),
    sconcat("\"value\":", ax__float_list_to_json(vals)),
    "\"type\":\"isosurface\"",
    "\"isomin\":0",
    "\"isomax\":0",
    "\"surface\":{\"count\":1}"
  ],
  if cs # false then
    parts: endcons(sconcat("\"colorscale\":", ax__json_string(cs)), parts),
  if op_val # false and op_val # 1.0 then
    parts: endcons(sconcat("\"opacity\":", string(float(op_val))), parts),
  parts: append(parts, ax__build_trace_style(style, string(eqn))),
  sconcat("{", simplode(parts, ","), "}"))$

/* 3D contour surface: ax_contour3d(expr, x, x0, x1, y, y0, y1) → surface with contour lines */
ax__trace_contour3d(obj, style) := block(
  [a, expr, xvar, xlo, xhi, yvar, ylo, yhi, n, data, xs, ys, zmat, parts, cs, nc],
  a: args(obj),
  if length(a) # 7 then
    error("ax_contour3d requires 7 arguments: ax_contour3d(expr, xvar, xlo, xhi, yvar, ylo, yhi)"),
  expr: a[1], xvar: a[2], xlo: a[3], xhi: a[4], yvar: a[5], ylo: a[6], yhi: a[7],
  n: ax__style_get(style, nticks),
  if n = false or n > 200 then n: 50,
  data: ax__sample_2d(expr, xvar, xlo, xhi, yvar, ylo, yhi, n, n),
  xs: data[1], ys: data[2], zmat: data[3],
  cs: ax__style_get(style, colorscale),
  nc: ax__style_get(style, ncontours),
  parts: [
    sconcat("\"x\":", ax__float_list_to_json(xs)),
    sconcat("\"y\":", ax__float_list_to_json(ys)),
    sconcat("\"z\":", ax__float_matrix_to_json(zmat)),
    "\"type\":\"surface\"",
    "\"contours\":{\"z\":{\"show\":true,\"usecolormap\":true,\"highlightcolor\":\"white\",\"project\":{\"z\":true}}}"
  ],
  if cs # false then
    parts: endcons(sconcat("\"colorscale\":", ax__json_string(cs)), parts),
  parts: append(parts, ax__build_trace_style(style, string(expr))),
  sconcat("{", simplode(parts, ","), "}"))$

/* 3D vector field: ax_vector_field3d(Fx, Fy, Fz, x, x0, x1, y, y0, y1, z, z0, z1) → cone */
ax__trace_vector_field_3d(obj, style) := block(
  [a, fxexpr, fyexpr, fzexpr, xvar, xlo, xhi, yvar, ylo, yhi, zvar, zlo, zhi,
   ng, data, xs, ys, zs, us, vs, ws, parts, cs, norm, sm],
  a: args(obj),
  if length(a) # 12 then
    error("ax_vector_field3d requires 12 arguments: ax_vector_field3d(Fx, Fy, Fz, x, x0, x1, y, y0, y1, z, z0, z1)"),
  fxexpr: a[1], fyexpr: a[2], fzexpr: a[3],
  xvar: a[4], xlo: a[5], xhi: a[6],
  yvar: a[7], ylo: a[8], yhi: a[9],
  zvar: a[10], zlo: a[11], zhi: a[12],
  ng: ax__style_get(style, ngrid),
  if ng = false or ng > 15 then ng: 8, /* 8^3 = 512 cones */
  data: ax__sample_vector_field_3d(fxexpr, fyexpr, fzexpr,
    xvar, xlo, xhi, yvar, ylo, yhi, zvar, zlo, zhi, ng),
  xs: data[1], ys: data[2], zs: data[3],
  us: data[4], vs: data[5], ws: data[6],
  cs: ax__style_get(style, colorscale),
  norm: ax__style_get(style, normalize),
  sm: if norm = true then "\"absolute\"" else "\"scaled\"",
  parts: [
    sconcat("\"x\":", ax__float_list_to_json(xs)),
    sconcat("\"y\":", ax__float_list_to_json(ys)),
    sconcat("\"z\":", ax__float_list_to_json(zs)),
    sconcat("\"u\":", ax__float_list_to_json(us)),
    sconcat("\"v\":", ax__float_list_to_json(vs)),
    sconcat("\"w\":", ax__float_list_to_json(ws)),
    "\"type\":\"cone\"",
    sconcat("\"sizemode\":", sm)
  ],
  if cs # false then
    parts: endcons(sconcat("\"colorscale\":", ax__json_string(cs)), parts),
  parts: append(parts, ax__build_trace_style(style, "vector field")),
  sconcat("{", simplode(parts, ","), "}"))$

/* 2D filled contour trace: ax_contour(expr, xvar, xlo, xhi, yvar, ylo, yhi) → contour */
ax__trace_contour_2d(obj, style) := block(
  [a, expr, xvar, xlo, xhi, yvar, ylo, yhi, n, data, xs, ys, zmat, parts, cs, nc, ss],
  a: args(obj),
  if length(a) # 7 then
    error("ax_contour requires 7 arguments: ax_contour(expr, xvar, xlo, xhi, yvar, ylo, yhi)"),
  expr: a[1], xvar: a[2], xlo: a[3], xhi: a[4], yvar: a[5], ylo: a[6], yhi: a[7],
  n: ax__style_get(style, nticks),
  if n = false or n > 200 then n: 80,
  data: ax__sample_2d(expr, xvar, xlo, xhi, yvar, ylo, yhi, n, n),
  xs: data[1], ys: data[2], zmat: data[3],
  cs: ax__style_get(style, colorscale),
  nc: ax__style_get(style, ncontours),
  ss: ax__style_get(style, showscale),
  parts: [
    sconcat("\"x\":", ax__float_list_to_json(xs)),
    sconcat("\"y\":", ax__float_list_to_json(ys)),
    sconcat("\"z\":", ax__float_matrix_to_json(zmat)),
    "\"type\":\"contour\""
  ],
  if cs # false then
    parts: endcons(sconcat("\"colorscale\":", ax__json_string(cs)), parts),
  if nc # false then
    parts: endcons(sconcat("\"ncontours\":", string(nc)), parts),
  if ss = true then
    parts: endcons("\"showscale\":true", parts)
  else if ss = false then
    parts: endcons("\"showscale\":false", parts),
  /* ss = 'auto → omit, use Plotly default */
  parts: append(parts, ax__build_trace_style(style, string(expr))),
  sconcat("{", simplode(parts, ","), "}"))$

/* 2D heatmap trace: ax_heatmap(z_matrix) or ax_heatmap(z_matrix, x_labels, y_labels)
   or ax_heatmap(expr, xvar, xlo, xhi, yvar, ylo, yhi) */
ax__trace_heatmap_2d(obj, style) := block(
  [a, nargs, parts, cs, ss, zmat, xs, ys, n, data, expr, xvar, xlo, xhi, yvar, ylo, yhi],
  a: args(obj),
  nargs: length(a),
  cs: ax__style_get(style, colorscale),
  ss: ax__style_get(style, showscale),
  if nargs = 7 then (
    /* Expression form: ax_heatmap(expr, xvar, xlo, xhi, yvar, ylo, yhi) */
    expr: a[1], xvar: a[2], xlo: a[3], xhi: a[4], yvar: a[5], ylo: a[6], yhi: a[7],
    n: ax__style_get(style, nticks),
    if n = false or n > 200 then n: 50,
    data: ax__sample_2d(expr, xvar, xlo, xhi, yvar, ylo, yhi, n, n),
    xs: data[1], ys: data[2], zmat: data[3],
    parts: [
      sconcat("\"x\":", ax__float_list_to_json(xs)),
      sconcat("\"y\":", ax__float_list_to_json(ys)),
      sconcat("\"z\":", ax__float_matrix_to_json(zmat)),
      "\"type\":\"heatmap\""
    ]
  ) else if nargs = 3 then (
    /* Matrix with labels: ax_heatmap(z_matrix, x_labels, y_labels) */
    zmat: args(ax__maybe_matrix(a[1])),  /* matrix or ndarray → list of rows */
    xs: a[2], ys: a[3],
    parts: [
      sconcat("\"x\":", ax__string_list_to_json(xs)),
      sconcat("\"y\":", ax__string_list_to_json(ys)),
      sconcat("\"z\":", ax__float_matrix_to_json(zmat)),
      "\"type\":\"heatmap\""
    ]
  ) else if nargs = 1 then (
    /* Matrix only: ax_heatmap(z_matrix) */
    zmat: args(ax__maybe_matrix(a[1])),  /* matrix or ndarray → list of rows */
    parts: [
      sconcat("\"z\":", ax__float_matrix_to_json(zmat)),
      "\"type\":\"heatmap\""
    ]
  ) else
    error("ax_heatmap: expected 1, 3, or 7 arguments"),
  if cs # false then
    parts: endcons(sconcat("\"colorscale\":", ax__json_string(cs)), parts),
  if ss # false and ss = false then
    parts: endcons("\"showscale\":false", parts),
  parts: append(parts, ax__build_trace_style(style, "heatmap")),
  sconcat("{", simplode(parts, ","), "}"))$

/* Convert a list of strings to a JSON array: ["a","b","c"] */
ax__string_list_to_json(lst) :=
  sconcat("[", simplode(map(ax__json_string, lst), ","), "]")$

/* 2D bar trace: ax_bar(categories, values) or ax_bar(values) */
ax__trace_bar_2d(obj, style) := block(
  [a, nargs, cats, vals, parts, c, bw],
  a: args(obj),
  nargs: length(a),
  if nargs = 2 then (
    cats: ax__maybe_list(a[1]), vals: ax__maybe_list(a[2])
  ) else if nargs = 1 then (
    vals: ax__maybe_list(a[1]),
    cats: makelist(i, i, 1, length(vals))
  ) else
    error("ax_bar: expected 1 or 2 arguments"),
  c: ax__style_get(style, color),
  bw: ax__style_get(style, bar_width),
  parts: [
    if listp(cats) and length(cats) > 0 and stringp(first(cats)) then
      sconcat("\"x\":", ax__string_list_to_json(cats))
    else
      sconcat("\"x\":", ax__float_list_to_json(cats)),
    sconcat("\"y\":", ax__float_list_to_json(vals)),
    "\"type\":\"bar\""
  ],
  if c # false then
    parts: endcons(sconcat("\"marker\":{\"color\":", ax__json_string(ax__color_to_css(c)), "}"), parts),
  if bw # false then
    parts: endcons(sconcat("\"width\":", string(float(bw))), parts),
  parts: append(parts, ax__build_trace_style(style, "bar")),
  sconcat("{", simplode(parts, ","), "}"))$

/* 2D histogram trace: ax_histogram(data) */
ax__trace_histogram_2d(obj, style) := block(
  [a, data, parts, c, nb],
  a: args(obj),
  if length(a) # 1 then
    error("ax_histogram: expected 1 argument (data list)"),
  data: ax__maybe_list(a[1]),
  c: ax__style_get(style, color),
  nb: ax__style_get(style, nbins),
  parts: [
    sconcat("\"x\":", ax__float_list_to_json(data)),
    "\"type\":\"histogram\""
  ],
  if c # false then
    parts: endcons(sconcat("\"marker\":{\"color\":", ax__json_string(ax__color_to_css(c)), "}"), parts),
  if nb # false then
    parts: endcons(sconcat("\"nbinsx\":", string(nb)), parts),
  parts: append(parts, ax__build_trace_style(style, "histogram")),
  sconcat("{", simplode(parts, ","), "}"))$

/* Box plot trace: ax_box(data) or ax_box(data, category) */
ax__trace_box_2d(obj, style) := block(
  [a, data, cat, parts, c, bp, bm],
  a: args(obj),
  if length(a) < 1 or length(a) > 2 then
    error("ax_box: expected 1 or 2 arguments: ax_box(data) or ax_box(data, category)"),
  data: ax__maybe_list(a[1]),
  c: ax__style_get(style, color),
  bp: ax__style_get(style, boxpoints),
  bm: ax__style_get(style, boxmean),
  parts: [
    sconcat("\"y\":", ax__float_list_to_json(data)),
    "\"type\":\"box\""
  ],
  if length(a) = 2 then (
    cat: a[2],
    if stringp(cat) then
      parts: endcons(sconcat("\"x\":", ax__string_list_to_json(makelist(cat, i, 1, length(data)))), parts)
  ),
  if c # false then
    parts: endcons(sconcat("\"marker\":{\"color\":", ax__json_string(ax__color_to_css(c)), "}"), parts),
  if bp # false then (
    if bp = 'all or bp = all then
      parts: endcons("\"boxpoints\":\"all\"", parts)
    else if bp = 'outliers or bp = outliers then
      parts: endcons("\"boxpoints\":\"outliers\"", parts)
    else if stringp(bp) then
      parts: endcons(sconcat("\"boxpoints\":", ax__json_string(bp)), parts)
  ),
  if bm # false then (
    if bm = true then
      parts: endcons("\"boxmean\":true", parts)
    else if bm = 'sd or bm = sd then
      parts: endcons("\"boxmean\":\"sd\"", parts)
    else if stringp(bm) then
      parts: endcons(sconcat("\"boxmean\":", ax__json_string(bm)), parts)
  ),
  parts: append(parts, ax__build_trace_style(style, "box")),
  sconcat("{", simplode(parts, ","), "}"))$

/* Violin plot trace: ax_violin(data) or ax_violin(data, category) */
ax__trace_violin_2d(obj, style) := block(
  [a, data, cat, parts, c, bp],
  a: args(obj),
  if length(a) < 1 or length(a) > 2 then
    error("ax_violin: expected 1 or 2 arguments: ax_violin(data) or ax_violin(data, category)"),
  data: ax__maybe_list(a[1]),
  c: ax__style_get(style, color),
  bp: ax__style_get(style, boxpoints),
  parts: [
    sconcat("\"y\":", ax__float_list_to_json(data)),
    "\"type\":\"violin\"",
    "\"box\":{\"visible\":true}",
    "\"meanline\":{\"visible\":true}"
  ],
  if length(a) = 2 then (
    cat: a[2],
    if stringp(cat) then
      parts: endcons(sconcat("\"x\":", ax__string_list_to_json(makelist(cat, i, 1, length(data)))), parts)
  ),
  if c # false then
    parts: endcons(sconcat("\"marker\":{\"color\":", ax__json_string(ax__color_to_css(c)), "}"), parts),
  if bp # false then (
    if bp = 'all or bp = all then
      parts: endcons("\"points\":\"all\"", parts)
    else if bp = 'outliers or bp = outliers then
      parts: endcons("\"points\":\"outliers\"", parts)
    else if stringp(bp) then
      parts: endcons(sconcat("\"points\":", ax__json_string(bp)), parts)
  ),
  parts: append(parts, ax__build_trace_style(style, "violin")),
  sconcat("{", simplode(parts, ","), "}"))$

/* Pie chart trace: ax_pie(values, labels) or ax_pie(values) */
ax__trace_pie_2d(obj, style) := block(
  [a, vals, lbls, parts, h],
  a: args(obj),
  if length(a) < 1 or length(a) > 2 then
    error("ax_pie: expected 1 or 2 arguments: ax_pie(values) or ax_pie(values, labels)"),
  vals: ax__maybe_list(a[1]),
  parts: [
    sconcat("\"values\":", ax__float_list_to_json(vals)),
    "\"type\":\"pie\""
  ],
  if length(a) = 2 then (
    lbls: a[2],
    parts: endcons(sconcat("\"labels\":", ax__string_list_to_json(lbls)), parts)
  ),
  h: ax__style_get(style, hole),
  if h # false then
    parts: endcons(sconcat("\"hole\":", string(float(h))), parts),
  parts: append(parts, ax__build_trace_style(style, "pie")),
  sconcat("{", simplode(parts, ","), "}"))$

/* Scatter with error bars: ax_error_bar(xs, ys, errors) or ax_error_bar(xs, ys, y_errors, x_errors) */
ax__trace_error_bar_2d(obj, style) := block(
  [a, xs, ys, parts, c],
  a: args(obj),
  if length(a) < 3 or length(a) > 4 then
    error("ax_error_bar: expected 3 or 4 arguments: ax_error_bar(xs, ys, y_errors) or ax_error_bar(xs, ys, y_errors, x_errors)"),
  xs: ax__maybe_list(a[1]), ys: ax__maybe_list(a[2]),
  c: ax__style_get(style, color),
  parts: [
    sconcat("\"x\":", ax__float_list_to_json(xs)),
    sconcat("\"y\":", ax__float_list_to_json(ys)),
    "\"type\":\"scatter\"",
    "\"mode\":\"markers\"",
    sconcat("\"marker\":", ax__build_marker_style(style)),
    sconcat("\"error_y\":{\"type\":\"data\",\"array\":", ax__float_list_to_json(ax__maybe_list(a[3])), ",\"visible\":true}")
  ],
  if length(a) = 4 then
    parts: endcons(sconcat("\"error_x\":{\"type\":\"data\",\"array\":", ax__float_list_to_json(ax__maybe_list(a[4])), ",\"visible\":true}"), parts),
  parts: append(parts, ax__build_trace_style(style, "error bars")),
  sconcat("{", simplode(parts, ","), "}"))$

/* 2D vector field trace: ax_vector_field(Fx, Fy, xvar, xlo, xhi, yvar, ylo, yhi)
   Returns a list of two scatter traces: [shaft_trace, head_trace]. */
ax__trace_vector_field_2d(obj, style) := block(
  [a, fxexpr, fyexpr, xvar, xlo, xhi, yvar, ylo, yhi, ng, sc, norm,
   data, xs, ys, fxmat, fymat,
   shaft_xs, shaft_ys, head_xs, head_ys, head_angles,
   max_mag, cell_size, scale_factor,
   c, nm, shaft_parts, head_parts, shaft_trace, head_trace,
   marker_color_part],
  a: args(obj),
  if length(a) # 8 then
    error("ax_vector_field requires 8 arguments: ax_vector_field(Fx, Fy, xvar, xlo, xhi, yvar, ylo, yhi)"),
  fxexpr: a[1], fyexpr: a[2],
  xvar: a[3], xlo: a[4], xhi: a[5],
  yvar: a[6], ylo: a[7], yhi: a[8],

  ng: ax__style_get(style, ngrid),
  if ng = false then ng: 12,
  sc: ax__style_get(style, arrow_scale),
  if sc = false then sc: 1.0,
  norm: ax__style_get(style, normalize),

  /* Sample the field */
  data: ax__sample_vector_field_2d(fxexpr, fyexpr, xvar, xlo, xhi, yvar, ylo, yhi, ng),
  xs: data[1], ys: data[2], fxmat: data[3], fymat: data[4],

  /* Find maximum magnitude for auto-scaling */
  max_mag: 0.0,
  for i: 1 thru ng do
    for j: 1 thru ng do block([m: sqrt(fxmat[i][j]^2 + fymat[i][j]^2)],
      if numberp(m) and m > max_mag then max_mag: m),

  /* Scale: make longest arrow about 80% of grid cell size */
  cell_size: min((float(xhi) - float(xlo)) / (ng - 1), (float(yhi) - float(ylo)) / (ng - 1)),
  scale_factor: if max_mag > 0 then 0.8 * cell_size / max_mag * float(sc)
                else cell_size * 0.8 * float(sc),

  /* Build shaft and head arrays */
  shaft_xs: [], shaft_ys: [],
  head_xs: [], head_ys: [], head_angles: [],

  for i: 1 thru ng do
    for j: 1 thru ng do block(
      [fx_val: fxmat[i][j], fy_val: fymat[i][j], mag, dx, dy, angle_deg],
      mag: sqrt(fx_val^2 + fy_val^2),
      if numberp(mag) and mag > 1e-15 then (
        if norm = true then (
          dx: fx_val / mag * cell_size * 0.4 * float(sc),
          dy: fy_val / mag * cell_size * 0.4 * float(sc)
        ) else (
          dx: fx_val * scale_factor,
          dy: fy_val * scale_factor
        ),
        /* Shaft: base → tip → null (null breaks the line) */
        shaft_xs: append(shaft_xs, [xs[i], xs[i] + dx, false]),
        shaft_ys: append(shaft_ys, [ys[j], ys[j] + dy, false]),
        /* Head: marker at tip with rotation angle */
        head_xs: endcons(xs[i] + dx, head_xs),
        head_ys: endcons(ys[j] + dy, head_ys),
        /* Plotly marker.angle rotates clockwise; triangle-up default points +y (90°) */
        angle_deg: 90 - atan2(dy, dx) * 180 / %pi,
        head_angles: endcons(float(angle_deg), head_angles)
      )
    ),

  /* Style */
  c: ax__style_get(style, color),
  nm: ax__style_get(style, name),
  if nm = false then nm: sconcat("(", string(fxexpr), ", ", string(fyexpr), ")"),

  /* Shaft trace: null-separated line segments */
  shaft_parts: [
    sconcat("\"x\":", ax__float_list_to_json(shaft_xs)),
    sconcat("\"y\":", ax__float_list_to_json(shaft_ys)),
    "\"type\":\"scatter\"",
    "\"mode\":\"lines\""
  ],
  if c # false then
    shaft_parts: endcons(sconcat("\"line\":{\"color\":", ax__json_string(ax__color_to_css(c)), ",\"width\":1}"), shaft_parts)
  else
    shaft_parts: endcons("\"line\":{\"width\":1}", shaft_parts),
  shaft_parts: endcons(sconcat("\"name\":", ax__json_string(nm)), shaft_parts),
  shaft_parts: endcons("\"hoverinfo\":\"skip\"", shaft_parts),
  shaft_trace: sconcat("{", simplode(shaft_parts, ","), "}"),

  /* Head trace: rotated triangle markers at arrow tips */
  marker_color_part: if c # false then sconcat("\"color\":", ax__json_string(ax__color_to_css(c)), ",") else "",
  head_parts: [
    sconcat("\"x\":", ax__float_list_to_json(head_xs)),
    sconcat("\"y\":", ax__float_list_to_json(head_ys)),
    "\"type\":\"scatter\"",
    "\"mode\":\"markers\"",
    sconcat("\"marker\":{\"symbol\":\"triangle-up\",\"size\":5,",
            marker_color_part,
            "\"angle\":", ax__float_list_to_json(head_angles), "}"),
    "\"showlegend\":false",
    "\"hoverinfo\":\"skip\""
  ],
  head_trace: sconcat("{", simplode(head_parts, ","), "}"),

  /* Return list of two traces */
  [shaft_trace, head_trace]
)$

/* 2D streamline trace: ax_streamline(Fx, Fy, xvar, xlo, xhi, yvar, ylo, yhi)
   Returns a list of scatter traces (one per trajectory). */
ax__trace_streamline_2d(obj, style) := block(
  [a, fxexpr, fyexpr, xvar, xlo, xhi, yvar, ylo, yhi,
   ips, tr, h, traces, c, lw, nm_base,
   path_fwd, path_bwd, full_path, xs, ys, parts,
   xstep, ystep],
  a: args(obj),
  if length(a) # 8 then
    error("ax_streamline requires 8 arguments: ax_streamline(Fx, Fy, xvar, xlo, xhi, yvar, ylo, yhi)"),
  fxexpr: a[1], fyexpr: a[2],
  xvar: a[3], xlo: float(a[4]), xhi: float(a[5]),
  yvar: a[6], ylo: float(a[7]), yhi: float(a[8]),

  ips: ax__style_get(style, initial_points),
  tr: ax__style_get(style, t_range),
  h: ax__style_get(style, dt),
  c: ax__style_get(style, color),
  lw: ax__style_get(style, line_width),

  if tr = false then tr: [0, 10],
  if h = false then h: 0.05,

  /* Auto-generate initial points if not specified: 3x3 interior grid */
  if ips = false then (
    xstep: (xhi - xlo) / 4,
    ystep: (yhi - ylo) / 4,
    ips: [],
    for i: 1 thru 3 do
      for j: 1 thru 3 do
        ips: endcons([xlo + i * xstep, ylo + j * ystep], ips)
  ),

  nm_base: ax__style_get(style, name),
  traces: [],

  for idx: 1 thru length(ips) do block(
    [x0: float(ips[idx][1]), y0: float(ips[idx][2]),
     path_fwd, path_bwd, full_path, xs, ys, parts],
    /* Integrate forward */
    path_fwd: ax__rk4_trajectory(fxexpr, fyexpr, xvar, yvar, x0, y0,
                                  tr[1], tr[2], abs(h), xlo, xhi, ylo, yhi),
    /* Integrate backward */
    path_bwd: ax__rk4_trajectory(fxexpr, fyexpr, xvar, yvar, x0, y0,
                                  tr[1], -tr[2], -abs(h), xlo, xhi, ylo, yhi),
    /* Combine: reverse of backward + forward (skip duplicate start point) */
    full_path: append(reverse(path_bwd), rest(path_fwd)),

    if length(full_path) > 1 then (
      xs: map(first, full_path),
      ys: map(second, full_path),
      parts: [
        sconcat("\"x\":", ax__float_list_to_json(xs)),
        sconcat("\"y\":", ax__float_list_to_json(ys)),
        "\"type\":\"scatter\"",
        "\"mode\":\"lines\""
      ],
      if c # false then
        parts: endcons(sconcat("\"line\":{\"color\":", ax__json_string(ax__color_to_css(c)),
                               ",\"width\":", string(if lw # false then lw else 1.5), "}"), parts)
      else
        parts: endcons(sconcat("\"line\":{\"width\":", string(if lw # false then lw else 1.5), "}"), parts),
      if nm_base # false then
        parts: endcons(sconcat("\"name\":", ax__json_string(sconcat(nm_base, " ", string(idx)))), parts)
      else if idx = 1 then
        parts: endcons(sconcat("\"name\":", ax__json_string("streamline")), parts)
      else
        parts: endcons("\"showlegend\":false", parts),
      parts: endcons("\"hoverinfo\":\"skip\"", parts),
      traces: endcons(sconcat("{", simplode(parts, ","), "}"), traces)
    )
  ),

  traces
)$

/* Dispatch to the correct 2D trace builder based on object type.
   Returns either a single JSON string or a list of JSON strings (for multi-trace objects). */
ax__build_trace_2d(obj_in, style_in) := block([objop, split, obj, style],
  split: ax__split_object_options(obj_in, style_in),
  obj: split[1], style: split[2],
  objop: op(obj),
  if objop = explicit then ax__trace_explicit_2d(obj, style)
  else if objop = parametric then ax__trace_parametric_2d(obj, style)
  else if objop = points then ax__trace_points_2d(obj, style)
  else if objop = lines then ax__trace_lines_2d(obj, style)
  else if objop = implicit then ax__trace_implicit_2d(obj, style)
  else if objop = label then ax__trace_label_2d(obj, style)
  else if objop = vector then ax__trace_vector_2d(obj, style)
  else if objop = polygon then ax__trace_polygon_2d(obj, style)
  else if objop = ax_trace then ax__trace_raw(obj)
  else if objop = rectangle then ax__shape_rectangle(obj, style)
  else if objop = ellipse then ax__shape_ellipse(obj, style)
  else if objop = hline or objop = vline then ax__shape_hvline(obj, style)
  else if objop = ax_contour then ax__trace_contour_2d(obj, style)
  else if objop = ax_heatmap then ax__trace_heatmap_2d(obj, style)
  else if objop = ax_bar then ax__trace_bar_2d(obj, style)
  else if objop = ax_histogram then ax__trace_histogram_2d(obj, style)
  else if objop = ax_vector_field then ax__trace_vector_field_2d(obj, style)
  else if objop = ax_streamline then ax__trace_streamline_2d(obj, style)
  else if objop = ax_box then ax__trace_box_2d(obj, style)
  else if objop = ax_violin then ax__trace_violin_2d(obj, style)
  else if objop = ax_pie then ax__trace_pie_2d(obj, style)
  else if objop = ax_error_bar then ax__trace_error_bar_2d(obj, style)
  else error("ax_draw2d: unsupported object type:", objop))$

/* Dispatch to the correct 3D trace builder based on object type */
ax__build_trace_3d(obj_in, style_in) := block([objop, split, obj, style],
  split: ax__split_object_options(obj_in, style_in),
  obj: split[1], style: split[2],
  objop: op(obj),
  if objop = explicit then ax__trace_explicit_3d(obj, style)
  else if objop = points then ax__trace_points_3d(obj, style)
  else if objop = lines then ax__trace_lines_3d(obj, style)
  else if objop = parametric then ax__trace_parametric_3d(obj, style)
  else if objop = parametric_surface then ax__trace_parametric_surface_3d(obj, style)
  else if objop = ax_trace then ax__trace_raw(obj)
  else if objop = implicit then ax__trace_implicit_3d(obj, style)
  else if objop = ax_contour3d then ax__trace_contour3d(obj, style)
  else if objop = ax_vector_field3d then ax__trace_vector_field_3d(obj, style)
  else error("ax_draw3d: unsupported object type:", objop))$

/* ========================================================================
 * Layout builders
 * ======================================================================== */

ax__build_layout_2d(opts) := block(
  [parts, xaxis_parts, yaxis_parts, v, tc, keys],
  /* diagram=true: no axes, grid, legend or hover, equal scales and a height
     fitted to the ranges -- each only where not given explicitly */
  if ax__layout_opt_value(opts, diagram, false) = true then (
    keys: map(lhs, opts),
    opts: append(opts, sublist(['xaxis = false, 'yaxis = false, 'grid = false, 'showlegend = false,
                                'aspect_ratio = true, 'height = 'fit],
                               lambda([d], not member(lhs(d), keys))))),
  tc: ax__theme_colors(opts),
  parts: [],
  xaxis_parts: [],
  yaxis_parts: [],
  for item in opts do block([key, val],
    key: lhs(item), val: rhs(item),
    if key = title then
      parts: endcons(ax__title_json(val, opts), parts)
    else if key = xrange then (
      if ax__layout_opt_value(opts, xreversed, false) = true then val: reverse(val),
      xaxis_parts: endcons(sconcat("\"range\":", ax__float_list_to_json(val)), xaxis_parts)
    )
    else if key = yrange then (
      if ax__layout_opt_value(opts, yreversed, false) = true then val: reverse(val),
      yaxis_parts: endcons(sconcat("\"range\":", ax__float_list_to_json(val)), yaxis_parts)
    )
    else if key = xtickvals then
      xaxis_parts: endcons(sconcat("\"tickvals\":", ax__float_list_to_json(val)), xaxis_parts)
    else if key = ytickvals then
      yaxis_parts: endcons(sconcat("\"tickvals\":", ax__float_list_to_json(val)), yaxis_parts)
    else if key = xticktext then
      xaxis_parts: endcons(sconcat("\"ticktext\":", ax__string_list_to_json(val)), xaxis_parts)
    else if key = yticktext then
      yaxis_parts: endcons(sconcat("\"ticktext\":", ax__string_list_to_json(val)), yaxis_parts)
    else if key = xtickformat then
      xaxis_parts: endcons(sconcat("\"tickformat\":", ax__json_string(val)), xaxis_parts)
    else if key = ytickformat then
      yaxis_parts: endcons(sconcat("\"tickformat\":", ax__json_string(val)), yaxis_parts)
    else if key = xzeroline then
      xaxis_parts: endcons(sconcat("\"zeroline\":", if val then "true" else "false"), xaxis_parts)
    else if key = yzeroline then
      yaxis_parts: endcons(sconcat("\"zeroline\":", if val then "true" else "false"), yaxis_parts)
    else if key = xreversed then (
      if val = true and not member(xrange, map(lhs, opts)) then
        xaxis_parts: endcons("\"autorange\":\"reversed\"", xaxis_parts)
    )
    else if key = yreversed then (
      if val = true and not member(yrange, map(lhs, opts)) then
        yaxis_parts: endcons("\"autorange\":\"reversed\"", yaxis_parts)
    )
    else if key = grid then (
      xaxis_parts: endcons(sconcat("\"showgrid\":", if val then "true" else "false"), xaxis_parts),
      yaxis_parts: endcons(sconcat("\"showgrid\":", if val then "true" else "false"), yaxis_parts)
    )
    else if key = xaxis then
      xaxis_parts: endcons(sconcat("\"visible\":", if val then "true" else "false"), xaxis_parts)
    else if key = yaxis then
      yaxis_parts: endcons(sconcat("\"visible\":", if val then "true" else "false"), yaxis_parts)
    else if key = xlabel then
      xaxis_parts: endcons(sconcat("\"title\":{\"text\":", ax__json_string(val), "}"), xaxis_parts)
    else if key = ylabel then
      yaxis_parts: endcons(sconcat("\"title\":{\"text\":", ax__json_string(val), "}"), yaxis_parts)
    else if key = showlegend then
      parts: endcons(sconcat("\"showlegend\":", if val then "true" else "false"), parts)
    else if key = aspect_ratio then (
      /* true ≡ 1; a number sets y-units per x-unit; false = off */
      if val # false then
        yaxis_parts: endcons(sconcat("\"scaleanchor\":\"x\",\"scaleratio\":",
          ax__float_to_json(if val = true then 1 else val)), yaxis_parts)
    )
    else if key = constrain then (
      /* "range" (Plotly default) widens a range to satisfy aspect_ratio;
         "domain" shrinks the plot area so xrange/yrange are kept exactly */
      xaxis_parts: endcons(sconcat("\"constrain\":", ax__json_string(val)), xaxis_parts),
      yaxis_parts: endcons(sconcat("\"constrain\":", ax__json_string(val)), yaxis_parts)
    )
    else if key = margin then
      parts: endcons(ax__margin_json(val), parts)
    else if key = width then (
      if val # 'auto then
        parts: endcons(sconcat("\"width\":", string(val)), parts)
    )
    else if key = height then (
      if val # 'auto and not member(val, ['fit, "fit"]) then
        parts: endcons(sconcat("\"height\":", string(val)), parts)
    )
    else if key = bar_mode then
      parts: endcons(sconcat("\"barmode\":", ax__json_string(val)), parts)
    else if key = plot_bgcolor then
      parts: endcons(sconcat("\"plot_bgcolor\":", ax__json_string(val)), parts)
    else if key = paper_bgcolor then
      parts: endcons(sconcat("\"paper_bgcolor\":", ax__json_string(val)), parts)
    else if key = logx then (
      if val then
        xaxis_parts: endcons("\"type\":\"log\"", xaxis_parts)
    )
    else if key = logy then (
      if val then
        yaxis_parts: endcons("\"type\":\"log\"", yaxis_parts)
    )
  ),
  /* Default dimensions if not explicitly provided; auto skips the default.
     When aspect_ratio=true and no explicit height, use square dimensions
     so the plot area doesn't get squished by scaleanchor. */
  if not member(width, map(lhs, opts)) and not ax__autosize_p(opts) then
    parts: endcons("\"width\":700", parts),
  if not member(height, map(lhs, opts)) and not ax__autosize_p(opts) then (
    if ax__layout_opt_value(opts, aspect_ratio, false) # false then
      parts: endcons("\"height\":700", parts)
    else
      parts: endcons("\"height\":450", parts)
  ),
  if member(ax__layout_opt_value(opts, height, false), ['fit, "fit"]) then
    parts: append(parts, ax__fit_height_parts(opts)),
  if ax__layout_opt_value(opts, diagram, false) = true then
    parts: endcons("\"hovermode\":false", parts),
  parts: append(parts, ax__common_layout_parts(opts), ax__theme_text_parts(tc)),
  /* Theme background (white by default; Plotly's own default is light blue) */
  if not member(plot_bgcolor, map(lhs, opts)) then
    parts: endcons(sconcat("\"plot_bgcolor\":", ax__json_string(tc[1])), parts),
  if not member(paper_bgcolor, map(lhs, opts)) then
    parts: endcons(sconcat("\"paper_bgcolor\":", ax__json_string(tc[1])), parts),
  xaxis_parts: endcons(ax__theme_axis_json(tc, true), xaxis_parts),
  yaxis_parts: endcons(ax__theme_axis_json(tc, true), yaxis_parts),
  parts: endcons(sconcat("\"xaxis\":{", simplode(xaxis_parts, ","), "}"), parts),
  parts: endcons(sconcat("\"yaxis\":{", simplode(yaxis_parts, ","), "}"), parts),
  ax__layout_merge_raw(sconcat("{", simplode(parts, ","), "}"),
                       ax__layout_opt_value(opts, layout_raw, false)))$

/* height=fit: the height at which the plot area shows xrange and yrange at
   the aspect ratio (1 unless aspect_ratio is a number) with nothing left
   over, for the given width (700 by default) and margins.  Without a margin
   option the margins are Aximar's fixed ones, emitted explicitly so other
   hosts lay the plot out the same way.  diagram=true falls back to the
   default square size when either range is automatic. */
ax__fit_height_parts(opts) := block(
  [xr, yr, w, ar, m, parts: [], h],
  xr: ax__layout_opt_value(opts, xrange, false),
  yr: ax__layout_opt_value(opts, yrange, false),
  if xr = false or yr = false then (
    if ax__layout_opt_value(opts, diagram, false) = true
      then return(["\"height\":700"])
      else error("height=fit needs both xrange and yrange")),
  w: ax__layout_opt_value(opts, width, 700),
  if not numberp(float(w)) then error("height=fit needs a numeric width, got", w),
  ar: ax__layout_opt_value(opts, aspect_ratio, true),
  ar: if ar = true or ar = false then 1 else float(ar),
  m: ax__layout_opt_value(opts, margin, false),
  if m = false then (m: [50, 30, 40, 50], parts: [ax__margin_json(m)])
  else if not listp(m) then m: [m, m, m, m],
  h: m[3] + m[4]
     + (w - m[1] - m[2]) * ar * abs(float(yr[2] - yr[1])) / abs(float(xr[2] - xr[1])),
  endcons(sconcat("\"height\":", string(round(h))), parts))$

/* margin=10 (all sides) or margin=[l, r, t, b] → "margin":{...} (pixels) */
ax__margin_json(val) := block([m],
  m: if listp(val) then val else [val, val, val, val],
  if length(m) # 4 then
    error("margin: expected a number or [l, r, t, b], got", val),
  sconcat("\"margin\":{\"l\":", ax__float_to_json(m[1]),
          ",\"r\":", ax__float_to_json(m[2]),
          ",\"t\":", ax__float_to_json(m[3]),
          ",\"b\":", ax__float_to_json(m[4]), "}"))$

ax__build_layout_3d(opts) := block(
  [parts, scene_parts, xaxis_parts, yaxis_parts, zaxis_parts],
  parts: [],
  scene_parts: [],
  xaxis_parts: [],
  yaxis_parts: [],
  zaxis_parts: [],
  for item in opts do block([key, val],
    key: lhs(item), val: rhs(item),
    if key = title then
      parts: endcons(ax__title_json(val, opts), parts)
    else if key = xrange then
      xaxis_parts: endcons(sconcat("\"range\":", ax__float_list_to_json(val)), xaxis_parts)
    else if key = yrange then
      yaxis_parts: endcons(sconcat("\"range\":", ax__float_list_to_json(val)), yaxis_parts)
    else if key = zrange then
      zaxis_parts: endcons(sconcat("\"range\":", ax__float_list_to_json(val)), zaxis_parts)
    else if key = xlabel then
      xaxis_parts: endcons(sconcat("\"title\":{\"text\":", ax__json_string(val), "}"), xaxis_parts)
    else if key = ylabel then
      yaxis_parts: endcons(sconcat("\"title\":{\"text\":", ax__json_string(val), "}"), yaxis_parts)
    else if key = zlabel then
      zaxis_parts: endcons(sconcat("\"title\":{\"text\":", ax__json_string(val), "}"), zaxis_parts)
    else if key = showlegend then
      parts: endcons(sconcat("\"showlegend\":", if val then "true" else "false"), parts)
    else if key = margin then
      parts: endcons(ax__margin_json(val), parts)
    else if key = width then (
      if val # 'auto then
        parts: endcons(sconcat("\"width\":", string(val)), parts)
    )
    else if key = height then (
      if val # 'auto then
        parts: endcons(sconcat("\"height\":", string(val)), parts)
    )
    else if key = paper_bgcolor then
      parts: endcons(sconcat("\"paper_bgcolor\":", ax__json_string(val)), parts)
    else if key = plot_bgcolor then
      /* Plotly 3D uses scene.bgcolor as the plot-area background */
      scene_parts: endcons(sconcat("\"bgcolor\":", ax__json_string(val)), scene_parts)
    else if key = logx then (
      if val then
        xaxis_parts: endcons("\"type\":\"log\"", xaxis_parts)
    )
    else if key = logy then (
      if val then
        yaxis_parts: endcons("\"type\":\"log\"", yaxis_parts)
    )
    else if key = logz then (
      if val then
        zaxis_parts: endcons("\"type\":\"log\"", zaxis_parts)
    )
  ),
  /* Default dimensions if not explicitly provided; auto skips the default */
  if not member(width, map(lhs, opts)) and not ax__autosize_p(opts) then
    parts: endcons("\"width\":700", parts),
  if not member(height, map(lhs, opts)) and not ax__autosize_p(opts) then
    parts: endcons("\"height\":450", parts),
  parts: append(parts, ax__common_layout_parts(opts)),
  block([tc: ax__theme_colors(opts)],
    parts: append(parts, ax__theme_text_parts(tc)),
    if not member(paper_bgcolor, map(lhs, opts)) then
      parts: endcons(sconcat("\"paper_bgcolor\":", ax__json_string(tc[1])), parts),
    if not member(plot_bgcolor, map(lhs, opts)) then
      scene_parts: endcons(sconcat("\"bgcolor\":", ax__json_string(tc[1])), scene_parts),
    xaxis_parts: endcons(ax__theme_axis_json(tc, true), xaxis_parts),
    yaxis_parts: endcons(ax__theme_axis_json(tc, true), yaxis_parts),
    zaxis_parts: endcons(ax__theme_axis_json(tc, true), zaxis_parts)),
  scene_parts: endcons(sconcat("\"xaxis\":{", simplode(xaxis_parts, ","), "}"), scene_parts),
  scene_parts: endcons(sconcat("\"yaxis\":{", simplode(yaxis_parts, ","), "}"), scene_parts),
  scene_parts: endcons(sconcat("\"zaxis\":{", simplode(zaxis_parts, ","), "}"), scene_parts),
  parts: endcons(sconcat("\"scene\":{", simplode(scene_parts, ","), "}"), parts),
  ax__layout_merge_raw(sconcat("{", simplode(parts, ","), "}"),
                       ax__layout_opt_value(opts, layout_raw, false)))$

/* ========================================================================
 * Output: deliver the Plotly JSON to the host.
 *
 * If kernel-events is loaded (aximar with AXIMAR_KERNEL_EVENTS=1), the
 * JSON goes inline in an `emit_display` event under the
 * `application/x-maxima-plotly` mime, so it never touches stdout or the
 * filesystem.  Otherwise it is written to a temp file (.plotly.json) and
 * the path is printed, where the stdout parser finds and reads it.
 * ======================================================================== */

/* True iff kernel-events is loaded.  Detected via errcatch on the
   feature-detect function it exports; works whether the package was
   loaded just now or at session init, and is harmless when absent. */
ax__kernel_events_loaded_p() := errcatch(kernel_events_available()) = [true]$

ax__deliver_plotly(json) := block([path, stream],
  if ax__kernel_events_loaded_p() then
    /* Wired host: display envelope only; a printed path would leak
       into the cell's text output. */
    emit_display([["application/x-maxima-plotly", json]])
  else (
    path: ax__mktemp(),
    stream: openw(path),
    printf(stream, "~a", json),
    close(stream),
    /* Print the path so the Aximar parser can find and read the file */
    print(path)))$

ax__emit_plotly(traces, layout) :=
  ax__emit_plotly_with_meta(traces, layout, false)$

/* Same as ax__emit_plotly but with an optional pre-built reactive
   metadata block (JSON string like "{\"view_id\":...,\"signals\":[...]}")
   spliced in as a top-level "_reactive" key.  Pass `false' to omit. */
ax__emit_plotly_with_meta(traces, layout, reactive_json) := block(
  [body],
  body: sconcat("\"data\":[", simplode(traces, ","), "],\"layout\":", layout),
  if reactive_json # false then
    body: sconcat(body, ",\"_reactive\":", reactive_json),
  ax__deliver_plotly(sconcat("{", body, "}")))$

/* ========================================================================
 * Reactive views: detect signals, resolve them for sampling, emit
 * the metadata the renderer needs to drive sliders, and remember
 * the original args so we can re-render on signal change.
 *
 * Status: v0 — depends on the `reactive' package being loaded for
 * signal detection.  When reactive isn't loaded the predicate
 * always returns no signals and ax_draw2d behaves exactly as before.
 *
 * Lookup is a simple Maxima alist; n is expected to be small
 * (one view per cell, low single-digit count of cells).  Upgrade
 * to a hash table when that stops being true.
 * ======================================================================== */

ax__view_registry: []$       /* list of [view_id, args, kind] entries */
ax__view_counter:  0$

/* Check whether `collect_signals' from the reactive package is
   defined.  Note: Maxima-level `:='-defined functions don't show up
   under ?fboundp (that's Lisp-side only).  Inspecting `properties'
   for the `function' tag is the reliable way to detect a Maxima
   function definition. */
ax__reactive_loaded_p() :=
  member('function, properties(collect_signals))$

/* All unique signal names referenced by any draw-object argument.
   Returns [] when the reactive package is not loaded. */
ax__collect_signals_in_args(args_list) := block(
  [all_signals: []],
  if not ax__reactive_loaded_p() then return([]),
  for item in args_list do
    if not atom(item) and ax__is_draw_object(item) then
      for sig in collect_signals(item) do
        if not member(sig, all_signals) then
          all_signals: endcons(sig, all_signals),
  all_signals)$

/* Apply resolve_signals to every draw-object in ARGS_LIST; leave
   layout / trace options untouched.  Returns a fresh list.
   Each iteration uses a temp variable rather than an inline
   if/then/else so the trailing `,' isn't swallowed by the else
   branch (Maxima parser quirk shared with several other sites). */
ax__resolve_signals_in_args(args_list) := block([out, slot],
  out: [],
  if not ax__reactive_loaded_p() then return(args_list),
  for item in args_list do (
    slot: item,
    if not atom(item) and ax__is_draw_object(item) then
      slot: resolve_signals(item),
    out: endcons(slot, out)
  ),
  out)$

/* Allocate a fresh view id and store the args so we can re-eval. */
ax__register_view(args_list, kind) := block([view_id],
  ax__view_counter: ax__view_counter + 1,
  view_id: sconcat("v_", string(ax__view_counter)),
  ax__view_registry: cons([view_id, args_list, kind], ax__view_registry),
  view_id)$

/* Look up the stored entry [args, kind] for a view_id; false on miss. */
ax__lookup_view(view_id) := block([found: false],
  for entry in ax__view_registry do
    if found = false and entry[1] = view_id then
      found: [entry[2], entry[3]],
  found)$

/* Drop every registered view.  Used by tests / cell re-runs. */
ax__clear_views() := (
  ax__view_registry: [],
  ax__view_counter: 0,
  'done)$

/* Build the _reactive JSON metadata block for a view.  SIGNAL_NAMES
   is a Maxima list of name strings; each name is looked up via
   signal_field to fill in lo/hi/value/kind/choices.  Fields are read
   by key, not position, so new widget kinds can add registry fields
   without breaking this.  Dropdown signals carry their choices list
   as an extra JSON field; other widget kinds omit it. */
ax__build_reactive_json(view_id, signal_names) := block(
  [parts: [], kind_str, fields, choices],
  for n in signal_names do (
    kind_str: string(signal_kind(n)),
    fields: [
      ["name",  ax__json_string(n)],
      ["lo",    ax__float_to_json(signal_field(n, 'lo))],
      ["hi",    ax__float_to_json(signal_field(n, 'hi))],
      ["value", ax__float_to_json(signal_value(n))],
      ["kind",  ax__json_string(kind_str)]
    ],
    choices: signal_field(n, 'choices),
    if choices # false then
      fields: endcons(["choices", ax__json_list(
                         map(lambda([c], ax__float_to_json(c)), choices))],
                      fields),
    parts: endcons(ax__json_obj(fields), parts)
  ),
  ax__json_obj([
    ["view_id", ax__json_string(view_id)],
    ["signals", ax__json_list(parts)]
  ]))$

/* ========================================================================
 * animate(obj, [param, lo, hi[, n]]) — paradigm-2 precomputed frames
 *
 * `animate` is a draw-object wrapper.  ax_draw2d / ax_draw3d detect it
 * during their arg scan, sample the wrapped obj at n parameter values,
 * and emit Plotly `frames` plus a slider + play/pause control.  No
 * new mime type — the existing application/x-maxima-plotly schema
 * gains optional `frames` + layout extras (sliders, updatemenus).
 * See doc/design/animate.md.
 * ======================================================================== */

ax__is_animate(obj) :=
  not atom(obj) and op(obj) = 'animate$

/* Unpack animate(inner, [param, lo, hi[, n]]) into [inner, param, lo, hi, n]. */
ax__animate_spec(obj) := block(
  [a, inner, spec, n],
  a: args(obj),
  if length(a) # 2 then
    error("animate expects (object, [param, lo, hi[, n]]); got args:", a),
  inner: a[1],
  spec: a[2],
  if not listp(spec) or length(spec) < 3 then
    error("animate: spec must be [param, lo, hi] or [param, lo, hi, n]; got:", spec),
  if not symbolp(spec[1]) then
    error("animate: param must be an unbound symbol; got:", spec[1]),
  n: if length(spec) >= 4 then spec[4] else 60,
  if not integerp(n) or n < 2 then
    error("animate: n must be an integer >= 2; got:", n),
  [inner, spec[1], spec[2], spec[3], n])$

/* n evenly-spaced floats from lo to hi, inclusive at both ends. */
ax__animate_param_values(lo, hi, n) := block([lof, hif, h],
  lof: float(lo), hif: float(hi),
  h: (hif - lof) / (n - 1),
  makelist(lof + i * h, i, 0, n - 1))$

/* Look up a single layout option value; default if not set. */
ax__layout_opt_value(opts, key, default) := block([found: false, v: default],
  for o in opts do (
    if not found and lhs(o) = key then (
      v: rhs(o),
      found: true
    )
  ),
  v)$

/* Format a parameter value for slider step labels: ~3 sig figs. */
ax__format_animate_value(v) := block([fv: float(v)],
  /* fv is a float, and 0.0 = 0 is false in Maxima */
  if abs(fv) = 0.0 then "0"
  else if abs(fv) < 0.001 or abs(fv) >= 10000 then
    printf(false, "~,3e", fv)
  else
    printf(false, "~,3f", fv))$

/* Build the JSON for one Plotly frame.
   TRACE_JSONS is a list of already-serialised trace strings.
   INDICES is the parallel list of base-trace indices each updates. */
ax__build_frame_json(name, trace_jsons, indices, [layout]) :=
  ax__json_obj(append([
    ["name",   ax__json_string(name)],
    ["data",   ax__json_list(trace_jsons)],
    ["traces", sconcat("[", simplode(map(string, indices), ","), "]")]],
    if layout = [] or first(layout) = false then [] else [["layout", first(layout)]]))$

/* True if a spec [inner, style, _, _] is eligible for the fast
   path: inner is an explicit(...) wrapper with numeric x-range,
   and compile_grid is available (numerics loaded).  Uses Maxima's
   Lisp escape — Maxima's own `fboundp' is just a noun form. */
ax__can_fast_sample_2d(spec) := block(
  [inner: spec[1], a, var, lo, hi],
  if not (not atom(inner) and op(inner) = 'explicit) then return(false),
  a: args(inner),
  if length(a) # 4 then return(false),
  var: a[2], lo: a[3], hi: a[4],
  if not symbolp(var) then return(false),
  if not numberp(float(lo)) or not numberp(float(hi)) then return(false),
  /* the fast path emits one plain line trace per frame; arrowheads and
     filled_func change the trace shape, so they take the per-frame path */
  if ax__curve_heads([0, 1], [0, 1], spec[2])[3] # "lines" then return(false),
  if ax__style_get(spec[2], filled_func) # false then return(false),
  not (?fboundp(compile_grid) = false))$

/* Bulk-sample all frames of an explicit(...) spec via compile_grid.
   Returns [rows, xs_json] where rows[i+1] is the list of y-values
   for frame i and xs_json is the pre-built x-axis JSON string
   (same for every frame; building it once saves N JSON builds
   per animation). */
ax__bulk_sample_explicit_2d(spec, param, param_values) := block(
  [inner: spec[1], style: spec[2], expr, var, lo, hi, n, n_frames,
   grid_data, mat, rows, xs, xs_json],
  expr: args(inner)[1], var: args(inner)[2],
  lo:   float(args(inner)[3]), hi: float(args(inner)[4]),
  n: ax__style_get(style, nticks), if n = false then n: 500,
  n_frames: length(param_values),
  grid_data: compile_grid(expr,
                          [[param, param_values[1],
                            param_values[n_frames], n_frames],
                           [var, lo, hi, n]]),
  mat:  np_to_matrix(grid_data),
  rows: args(mat),
  xs:   makelist(lo + i * (hi - lo) / (n - 1), i, 0, n - 1),
  xs_json: ax__float_list_to_json_fast(xs),
  [rows, xs_json])$

/* Fast list-to-JSON for arrays known to contain only Maxima
   floats (i.e. compile_grid's output).  Skips the per-element
   numberp/NaN-check overhead that ax__float_to_json does for
   defensive reasons in the general path.  ~3x faster on 500-pt
   lists in microbench; visible end-to-end on long animations. */
ax__float_list_to_json_fast(lst) :=
  sconcat("[", simplode(map(string, lst), ","), "]")$

/* Build the trace JSON for an explicit(...) wrapper from a
   pre-built x-axis JSON string (constant across all frames) and a
   y-values list (the row sampled for this frame).  Mirrors
   ax__trace_explicit_2d's output minus the sampling step. */
ax__explicit_trace_json_from_samples(xs_json, ys, style, label) := block(
  [parts],
  parts: [
    sconcat("\"x\":", xs_json),
    sconcat("\"y\":", ax__float_list_to_json_fast(ys)),
    "\"type\":\"scatter\"",
    "\"mode\":\"lines\"",
    sconcat("\"line\":", ax__build_line_style(style))
  ],
  parts: append(parts, ax__build_trace_style(style, label)),
  sconcat("{", simplode(parts, ","), "}"))$

/* Build all frames for a 2D figure.
   ANIMATE_SPECS is a list of [inner, style, start_idx, count] tuples
   captured during the scan pass.  Each entry's COUNT must match the
   number of traces the trace-builder produces for the substituted obj
   at every parameter value (Plotly requires consistent trace shape).

   For specs where inner is `explicit(...)` and the numerics package
   is loaded, the per-frame sampling is replaced by one bulk
   compile_grid call covering the whole (frames × x-samples) grid —
   typically 3-7x faster on common expressions, scaling better with
   grid size.  All other shapes (parametric, contour, vector field,
   …) keep the per-frame subst path. */
ax__build_frames_2d(animate_specs, param, param_values, [lay_opt]) := block(
  [sample_caches, frames, n_frames, i, p, all_traces, all_indices,
   spec_idx, spec, inner, style, start_idx, count,
   raw, traces_list, idx, frame, cache, label, lay, anim_keys, layout_json],
  /* layout objects (labels, arrows, shapes) inside animate(...): each frame
     carries the whole annotations / shapes array for every key that has
     an animated object, since Plotly replaces those arrays whole */
  lay: if lay_opt = [] then [] else first(lay_opt),
  anim_keys: unique(map(first, sublist(lay, lambda([e], e[3] # false)))),
  /* Pre-compute the bulk samples for fast-path specs.  Split the
     conditional into separate statements; `c: if ... then ... else
     ..., next-stmt' parses ambiguously in Maxima's `,'-separated
     block syntax. */
  sample_caches: [],
  for spec_idx: 1 thru length(animate_specs) do block(
    [s: animate_specs[spec_idx], c: false],
    if ax__can_fast_sample_2d(s) then
      c: ax__bulk_sample_explicit_2d(s, param, param_values),
    sample_caches: endcons(c, sample_caches)),
  frames: [],
  n_frames: length(param_values),
  for i: 0 thru n_frames - 1 do (
    p: param_values[i + 1],
    all_traces: [],
    all_indices: [],
    for spec_idx: 1 thru length(animate_specs) do block(
      [],
      spec: animate_specs[spec_idx],
      inner: spec[1],
      style: spec[2],
      start_idx: spec[3],
      count: spec[4],
      cache: sample_caches[spec_idx],
      if cache # false then (
        /* Fast path: bulk-sampled.  cache = [rows, xs]. */
        label: string(subst(p, param, args(inner)[1])),
        all_traces: endcons(
          ax__explicit_trace_json_from_samples(
            cache[2], cache[1][i + 1], style, label),
          all_traces),
        all_indices: endcons(start_idx, all_indices)
      ) else (
        /* Slow path: subst + per-frame trace build. */
        raw: ax__build_trace_2d(subst(p, param, inner), style),
        traces_list: if listp(raw) then raw else [raw],
        if length(traces_list) # count then
          error("animate: frame", i, "produced", length(traces_list),
                "traces but frame 0 produced", count),
        for idx: 0 thru count - 1 do (
          all_traces: endcons(traces_list[idx + 1], all_traces),
          all_indices: endcons(start_idx + idx, all_indices)
        )
      )
    ),
    layout_json: if anim_keys = [] then false
                 else ax__json_obj(map(lambda([k],
                        [k, ax__json_list(ax__layout_items_at(lay, k, param, p))]), anim_keys)),
    frame: ax__build_frame_json(string(i), all_traces, all_indices, layout_json),
    frames: endcons(frame, frames)
  ),
  frames)$

/* Same as ax__build_frames_2d but for 3D objects. */
ax__build_frames_3d(animate_specs, param, param_values) := block(
  [frames, n_frames, i, p, all_traces, all_indices,
   spec, inner, style, start_idx, count, raw, traces_list, idx, frame],
  frames: [],
  n_frames: length(param_values),
  for i: 0 thru n_frames - 1 do (
    p: param_values[i + 1],
    all_traces: [],
    all_indices: [],
    for spec in animate_specs do (
      inner: spec[1],
      style: spec[2],
      start_idx: spec[3],
      count: spec[4],
      raw: ax__build_trace_3d(subst(p, param, inner), style),
      traces_list: if listp(raw) then raw else [raw],
      if length(traces_list) # count then
        error("animate: frame", i, "produced", length(traces_list),
              "traces but frame 0 produced", count),
      for idx: 0 thru count - 1 do (
        all_traces: endcons(traces_list[idx + 1], all_traces),
        all_indices: endcons(start_idx + idx, all_indices)
      )
    ),
    frame: ax__build_frame_json(string(i), all_traces, all_indices),
    frames: endcons(frame, frames)
  ),
  frames)$

/* Slider JSON for animated figures. */
ax__build_slider_json(param_values, param, layout_opts) := block(
  [prefix_text, steps, i, p, label, step_json],
  prefix_text: sconcat(
    ax__layout_opt_value(layout_opts, slider_label, string(param)),
    " = "),
  steps: [],
  for i: 0 thru length(param_values) - 1 do (
    p: param_values[i + 1],
    label: ax__format_animate_value(p),
    step_json: ax__json_obj([
      ["label",  ax__json_string(label)],
      ["method", ax__json_string("animate")],
      ["args",   sconcat("[[", ax__json_string(string(i)), "],",
                          "{\"mode\":\"immediate\",",
                          "\"frame\":{\"duration\":0,\"redraw\":true},",
                          "\"transition\":{\"duration\":0}}]")]
    ]),
    steps: endcons(step_json, steps)
  ),
  ax__json_obj([
    ["active",       "0"],
    ["currentvalue", ax__json_obj([["prefix", ax__json_string(prefix_text)]])],
    ["steps",        ax__json_list(steps)]
  ]))$

/* Play / pause updatemenu JSON. */
ax__build_updatemenus_json(layout_opts) := block(
  [fps_val, frame_dur, transition_dur, play_btn, pause_btn],
  fps_val:        ax__layout_opt_value(layout_opts, fps, 12),
  frame_dur:      round(1000.0 / fps_val),
  transition_dur: ax__layout_opt_value(layout_opts, transition_duration, frame_dur),
  play_btn: ax__json_obj([
    ["label",  ax__json_string("▶")],
    ["method", ax__json_string("animate")],
    ["args",   sconcat("[null,{\"frame\":{\"duration\":", string(frame_dur),
                        ",\"redraw\":true},\"fromcurrent\":true,",
                        "\"transition\":{\"duration\":", string(transition_dur),
                        ",\"easing\":\"linear\"}}]")]
  ]),
  pause_btn: ax__json_obj([
    ["label",  ax__json_string("❚❚")],
    ["method", ax__json_string("animate")],
    ["args",
      "[[null],{\"mode\":\"immediate\",\"frame\":{\"duration\":0,\"redraw\":false},\"transition\":{\"duration\":0}}]"]
  ]),
  ax__json_obj([
    ["type",       ax__json_string("buttons")],
    ["showactive", "false"],
    ["buttons",    ax__json_list([play_btn, pause_btn])]
  ]))$

/* loop= was documented in the animate design but never implemented
   (Plotly's animate has no looping), so reject it rather than ignore it */
ax__check_loop_option(layout_opts) :=
  if member(loop, map(lhs, layout_opts)) then
    error("loop: not implemented; an animation plays once per press of the play button")$

/* Splice sliders + updatemenus into an existing layout JSON object.
   Assumes LAYOUT_JSON has at least one field (always true since
   ax__build_layout_2d/3d unconditionally set width + height). */
ax__layout_add_animation(layout_json, slider_json, updatemenus_json) := block(
  [body],
  /* Trim the trailing "}" */
  body: substring(layout_json, 1, slength(layout_json)),
  sconcat(body,
          ",\"sliders\":[",     slider_json,      "],",
           "\"updatemenus\":[", updatemenus_json, "]}"))$

/* Emit with animation: data + extended layout + frames at top level. */
ax__emit_plotly_animated(traces, layout, frames_jsons) := block(
  [],
  ax__deliver_plotly(sconcat(
    "{\"data\":[",   simplode(traces, ","), "],",
    "\"layout\":",   layout, ",",
    "\"frames\":",   ax__json_list(frames_jsons), "}")))$

/* ========================================================================
 * Public API: ax_draw2d, ax_draw3d, ax_plot2d
 * ======================================================================== */

ax_draw2d([ax__args]) := ax__draw2d_impl(ax__args, false)$

/* The shared body of ax_draw2d, also called by ax__replot_2d for
   the reactive re-render path.  When REUSE_VIEW_ID is false a fresh
   view_id is allocated; otherwise the supplied id is used and no
   new registry entry is made (re-renders keep the original entry). */
ax__draw2d_impl(ax__args_in, reuse_view_id) := block(
  [ax__args, signal_names, has_signals, view_id, reactive_json,
   traces, lay: [], annotations, shapes, layout_opts, style,
   animate_specs, anim_param, anim_lo, anim_hi, anim_n, has_anim,
   param_values, frames_jsons, layout_json, slider_json, updatemenus_json],
  ax__args_in: ax__expand_args(ax__args_in),
  /* === Reactive: detect signals BEFORE resolving (so we know what
     to put in the _reactive block), then resolve so the sampler
     never sees signal noun forms. === */
  signal_names: ax__collect_signals_in_args(ax__args_in),
  has_signals:  signal_names # [],
  if has_signals then (
    view_id: if reuse_view_id = false
               then ax__register_view(ax__args_in, "2d")
               else reuse_view_id,
    reactive_json: ax__build_reactive_json(view_id, signal_names),
    ax__args: ax__resolve_signals_in_args(ax__args_in)
  ) else (
    view_id: false,
    reactive_json: false,
    ax__args: ax__args_in
  ),
  traces: [],
  layout_opts: [],
  style: ax__default_style(),
  animate_specs: [],
  has_anim: false,
  anim_param: false, anim_lo: false, anim_hi: false, anim_n: false,
  for item in ax__args do (
    if ax__is_layout_option(item) then
      layout_opts: endcons(item, layout_opts)
    else if ax__is_trace_option(item) then
      style: ax__apply_option(style, item)
    else if ax__is_animate(item) then
      block([spec, split, inner, ostyle, p_lo, raw0, traces0, start_idx, count],
        if has_signals then
          error("ax_draw2d: animate(...) and signal(...) in the same call",
                " is not supported in v0"),
        spec: ax__animate_spec(item),
        if not has_anim then (
          anim_param: spec[2],
          anim_lo:    spec[3],
          anim_hi:    spec[4],
          anim_n:     spec[5],
          has_anim:   true
        ) else (
          if spec[2] # anim_param then
            error("ax_draw2d: all animate(...) wrappers must share the same param; got",
                  anim_param, "and", spec[2]),
          if spec[3] # anim_lo or spec[4] # anim_hi or spec[5] # anim_n then
            error("ax_draw2d: all animate(...) wrappers must share the same [lo, hi, n]")
        ),
        /* split per-object options here so the stored spec is a plain
           explicit(...) the compile_grid fast path recognises */
        split:   ax__split_object_options(spec[1], style),
        inner:   split[1],
        ostyle:  split[2],
        p_lo:    float(anim_lo),
        raw0:    ax__build_trace_2d(subst(p_lo, anim_param, inner), ostyle),
        if ax__layout_result_p(raw0) then
          /* labels, arrows and shapes live in the layout: each frame
             carries the whole annotations / shapes arrays (see lay) */
          lay: endcons([ax__layout_result_key(raw0), first(args(raw0)), [inner, ostyle]], lay)
        else (
          traces0: if listp(raw0) then raw0 else [raw0],
          start_idx: length(traces),
          count:     length(traces0),
          animate_specs: endcons([inner, ostyle, start_idx, count], animate_specs),
          traces: append(traces, traces0))
      )
    else if ax__is_draw_object(item) then
      block([result: ax__build_trace_2d(item, style)],
        if ax__layout_result_p(result) then
          lay: endcons([ax__layout_result_key(result), first(args(result)), false], lay)
        else if listp(result) then
          traces: append(traces, result)
        else
          traces: endcons(result, traces))
    else error("ax_draw2d: unrecognized argument:", item)
  ),
  ax__check_loop_option(layout_opts),
  layout_json: ax__build_layout_2d(layout_opts),
  annotations: ax__layout_items(lay, "annotations"),
  shapes: ax__layout_items(lay, "shapes"),
  if annotations # [] then
    layout_json: ax__layout_add_annotations(layout_json, annotations),
  if shapes # [] then
    layout_json: ax__layout_add_array(layout_json, "shapes", shapes),
  if has_anim then (
    param_values:     ax__animate_param_values(anim_lo, anim_hi, anim_n),
    frames_jsons:     ax__build_frames_2d(animate_specs, anim_param, param_values, lay),
    slider_json:      ax__build_slider_json(param_values, anim_param, layout_opts),
    updatemenus_json: ax__build_updatemenus_json(layout_opts),
    layout_json:      ax__layout_add_animation(layout_json, slider_json, updatemenus_json),
    ax__emit_plotly_animated(traces, layout_json, frames_jsons)
  ) else
    ax__emit_plotly_with_meta(traces, layout_json, reactive_json),
  'done)$

/* Re-render the figure for VIEW_ID using whatever the current
   signal values are.  Returns 'done (the new figure JSON path is
   printed by the underlying emit).  Errors if VIEW_ID isn't known. */
ax__replot_2d(view_id) := block([entry],
  entry: ax__lookup_view(view_id),
  if entry = false then
    error("ax__replot_2d: unknown view id: ", view_id),
  if entry[2] # "2d" then
    error("ax__replot_2d: view ", view_id, " was registered for ",
          entry[2], ", not 2d"),
  ax__draw2d_impl(entry[1], view_id))$

ax_draw3d([ax__args]) := ax__draw3d_impl(ax__args, false)$

/* The shared body of ax_draw3d, also called by ax__replot_3d for the
   reactive re-render path.  Mirrors ax__draw2d_impl: a false reuse id
   allocates a fresh registry entry; an explicit id keeps the original. */
ax__draw3d_impl(ax__args_in, reuse_view_id) := block(
  [ax__args, signal_names, has_signals, view_id, reactive_json,
   traces, layout_opts, style,
   animate_specs, anim_param, anim_lo, anim_hi, anim_n, has_anim,
   param_values, frames_jsons, layout_json, slider_json, updatemenus_json],
  ax__args_in: ax__expand_args(ax__args_in),
  /* === Reactive: detect signals BEFORE resolving, then resolve so
     the sampler never sees signal noun forms. === */
  signal_names: ax__collect_signals_in_args(ax__args_in),
  has_signals:  signal_names # [],
  if has_signals then (
    view_id: if reuse_view_id = false
               then ax__register_view(ax__args_in, "3d")
               else reuse_view_id,
    reactive_json: ax__build_reactive_json(view_id, signal_names),
    ax__args: ax__resolve_signals_in_args(ax__args_in)
  ) else (
    view_id: false,
    reactive_json: false,
    ax__args: ax__args_in
  ),
  traces: [],
  layout_opts: [],
  style: ax__default_style(),
  animate_specs: [],
  has_anim: false,
  anim_param: false, anim_lo: false, anim_hi: false, anim_n: false,
  for item in ax__args do (
    if ax__is_layout_option(item) then
      layout_opts: endcons(item, layout_opts)
    else if ax__is_trace_option(item) then
      style: ax__apply_option(style, item)
    else if ax__is_animate(item) then
      block([spec, split, inner, ostyle, p_lo, raw0, traces0, start_idx, count],
        if has_signals then
          error("ax_draw3d: animate(...) and signal(...) in the same call",
                " is not supported in v0"),
        spec: ax__animate_spec(item),
        if not has_anim then (
          anim_param: spec[2],
          anim_lo:    spec[3],
          anim_hi:    spec[4],
          anim_n:     spec[5],
          has_anim:   true
        ) else (
          if spec[2] # anim_param then
            error("ax_draw3d: all animate(...) wrappers must share the same param; got",
                  anim_param, "and", spec[2]),
          if spec[3] # anim_lo or spec[4] # anim_hi or spec[5] # anim_n then
            error("ax_draw3d: all animate(...) wrappers must share the same [lo, hi, n]")
        ),
        split:   ax__split_object_options(spec[1], style),
        inner:   split[1],
        ostyle:  split[2],
        p_lo:    float(anim_lo),
        raw0:    ax__build_trace_3d(subst(p_lo, anim_param, inner), ostyle),
        traces0: if listp(raw0) then raw0 else [raw0],
        start_idx: length(traces),
        count:     length(traces0),
        animate_specs: endcons([inner, ostyle, start_idx, count], animate_specs),
        traces: append(traces, traces0)
      )
    else if ax__is_draw_object(item) then
      block([result: ax__build_trace_3d(item, style)],
        if listp(result) then
          traces: append(traces, result)
        else
          traces: endcons(result, traces))
    else error("ax_draw3d: unrecognized argument:", item)
  ),
  ax__check_loop_option(layout_opts),
  layout_json: ax__build_layout_3d(layout_opts),
  if has_anim then (
    param_values:     ax__animate_param_values(anim_lo, anim_hi, anim_n),
    frames_jsons:     ax__build_frames_3d(animate_specs, anim_param, param_values),
    slider_json:      ax__build_slider_json(param_values, anim_param, layout_opts),
    updatemenus_json: ax__build_updatemenus_json(layout_opts),
    layout_json:      ax__layout_add_animation(layout_json, slider_json, updatemenus_json),
    ax__emit_plotly_animated(traces, layout_json, frames_jsons)
  ) else
    ax__emit_plotly_with_meta(traces, layout_json, reactive_json),
  'done
)$

/* Re-render the figure for VIEW_ID (3d) with whatever the current
   signal values are.  Errors if VIEW_ID isn't known or is 2d. */
ax__replot_3d(view_id) := block([entry],
  entry: ax__lookup_view(view_id),
  if entry = false then
    error("ax__replot_3d: unknown view id: ", view_id),
  if entry[2] # "3d" then
    error("ax__replot_3d: view ", view_id, " was registered for ",
          entry[2], ", not 3d"),
  ax__draw3d_impl(entry[1], view_id))$

/* Dispatch to the right replot based on the view's registered kind.
   This is the single entry point the renderer should call; it keeps
   the host language from needing to know about 2d vs 3d view ids. */
ax__replot(view_id) := block([entry],
  entry: ax__lookup_view(view_id),
  if entry = false then
    error("ax__replot: unknown view id: ", view_id),
  if entry[2] = "2d" then ax__draw2d_impl(entry[1], view_id)
  else if entry[2] = "3d" then ax__draw3d_impl(entry[1], view_id)
  else error("ax__replot: unknown view kind: ", entry[2]))$

/* Test whether an argument is a range [var, lo, hi]: a list of 3 with a
   non-numeric symbol as first element */
ax__is_range(x) :=
  listp(x) and length(x) = 3 and symbolp(x[1]) and not numberp(x[1])$

/* Test whether an argument is data: an ndarray or a list of numbers/sublists */
ax__is_data(x) :=
  ax__ndarray_p(x) or (listp(x) and length(x) > 0 and not symbolp(first(x)))$

/* ax_plot2d: plot expressions and/or data as line plots.
   Arguments are consumed as (y, x) pairs followed by options:
     ax_plot2d(y1, x1, y2, x2, ..., opts...)
   Where:
     y — an expression, list of expressions, ndarray, or list of numbers
     x — a range [var, lo, hi] (for expressions) or ndarray/list (for data)
   Examples:
     ax_plot2d(sin(x), [x, -%pi, %pi])
     ax_plot2d([sin(x), cos(x)], [x, -3, 3])
     ax_plot2d(ys, xs)
     ax_plot2d(sin(x), [x, -3, 3], ys, xs, title="Mixed") */
ax_plot2d([ax__args]) := block(
  [draw_args, i, y_arg, x_arg],
  if length(ax__args) < 1 then
    error("ax_plot2d requires at least one argument"),
  draw_args: [],
  i: 1,
  while i <= length(ax__args) do (
    if ax__is_layout_option(ax__args[i]) or ax__is_trace_option(ax__args[i]) then (
      /* Collect option */
      draw_args: endcons(ax__args[i], draw_args),
      i: i + 1
    ) else (
      /* Consume a (y, x) pair */
      y_arg: ax__args[i],
      if i + 1 > length(ax__args) then
        error("ax_plot2d: missing range or x-data after", y_arg),
      i: i + 1,
      x_arg: ax__args[i],
      i: i + 1,
      if ax__is_range(x_arg) then (
        /* Expression mode: y is expression(s), x is [var, lo, hi] */
        if listp(y_arg) then
          for e in y_arg do
            draw_args: endcons(explicit(e, x_arg[1], x_arg[2], x_arg[3]), draw_args)
        else
          draw_args: endcons(explicit(y_arg, x_arg[1], x_arg[2], x_arg[3]), draw_args)
      ) else if ax__is_data(x_arg) then (
        /* Data mode: y is data, x is data */
        if listp(y_arg) and length(y_arg) > 0
           and (listp(first(y_arg)) or ax__ndarray_p(first(y_arg))) then
          /* List of y series sharing one x */
          for ys in y_arg do
            draw_args: endcons(lines(x_arg, ys), draw_args)
        else
          draw_args: endcons(lines(x_arg, y_arg), draw_args)
      ) else
        error("ax_plot2d: expected a range [var,lo,hi] or data after", y_arg)
    )
  ),
  apply(ax_draw2d, draw_args)
)$

/* ========================================================================
 * ax_polar: standalone polar coordinate plotting
 * ======================================================================== */

/* Build polar layout from options */
ax__build_layout_polar(opts) := block(
  [parts, polar_parts, radial_parts, angular_parts],
  parts: [],
  polar_parts: [],
  radial_parts: [],
  angular_parts: [],
  for item in opts do block([key, val],
    key: lhs(item), val: rhs(item),
    if key = title then
      parts: endcons(ax__title_json(val, opts), parts)
    else if key = showlegend then
      parts: endcons(sconcat("\"showlegend\":", if val then "true" else "false"), parts)
    else if key = margin then
      parts: endcons(ax__margin_json(val), parts)
    else if key = width then (
      if val # 'auto then
        parts: endcons(sconcat("\"width\":", string(val)), parts)
    )
    else if key = height then (
      if val # 'auto then
        parts: endcons(sconcat("\"height\":", string(val)), parts)
    )
    else if key = plot_bgcolor then
      parts: endcons(sconcat("\"plot_bgcolor\":", ax__json_string(val)), parts)
    else if key = paper_bgcolor then
      parts: endcons(sconcat("\"paper_bgcolor\":", ax__json_string(val)), parts)
  ),
  /* Default dimensions if not explicitly provided; auto skips the default */
  if not member(width, map(lhs, opts)) and not ax__autosize_p(opts) then
    parts: endcons("\"width\":700", parts),
  if not member(height, map(lhs, opts)) and not ax__autosize_p(opts) then
    parts: endcons("\"height\":450", parts),
  parts: append(parts, ax__common_layout_parts(opts)),
  block([tc: ax__theme_colors(opts)],
    parts: append(parts, ax__theme_text_parts(tc)),
    if not member(plot_bgcolor, map(lhs, opts)) then
      parts: endcons(sconcat("\"plot_bgcolor\":", ax__json_string(tc[1])), parts),
    if not member(paper_bgcolor, map(lhs, opts)) then
      parts: endcons(sconcat("\"paper_bgcolor\":", ax__json_string(tc[1])), parts),
    /* the polar plot area is polar.bgcolor; plot_bgcolor sets it too */
    polar_parts: endcons(sconcat("\"bgcolor\":",
                                 ax__json_string(ax__layout_opt_value(opts, plot_bgcolor, tc[1]))),
                         polar_parts),
    radial_parts: endcons(ax__theme_axis_json(tc, false), radial_parts),
    angular_parts: endcons(ax__theme_axis_json(tc, false), angular_parts)),
  /* Axis line and grid colors for polar axes */
  polar_parts: endcons(sconcat("\"radialaxis\":{", simplode(radial_parts, ","), "}"), polar_parts),
  polar_parts: endcons(sconcat("\"angularaxis\":{", simplode(angular_parts, ","), "}"), polar_parts),
  parts: endcons(sconcat("\"polar\":{", simplode(polar_parts, ","), "}"), parts),
  ax__layout_merge_raw(sconcat("{", simplode(parts, ","), "}"),
                       ax__layout_opt_value(opts, layout_raw, false)))$

/* ax_polar: plot r(θ) in polar coordinates.
   ax_polar(expr, [θ, lo, hi], opts...)
   ax_polar([e1, e2, ...], [θ, lo, hi], opts...) */
ax_polar([ax__args]) := block(
  [exprs, range, var, lo, hi, opts, traces, layout_opts, style,
   n, data, xs, ys, rs, thetas, parts, expr],
  if length(ax__args) < 2 then
    error("ax_polar requires at least an expression and a range"),
  /* First arg: expression or list of expressions */
  if listp(ax__args[1]) and length(ax__args[1]) = 3
     and atom(ax__args[1][1]) then
    error("ax_polar: first argument must be an expression or list of expressions"),
  if listp(ax__args[1]) then
    exprs: ax__args[1]
  else
    exprs: [ax__args[1]],
  /* Second arg: range [θ, lo, hi] */
  range: ax__args[2],
  if not listp(range) or length(range) # 3 then
    error("ax_polar: range must be [variable, min, max]"),
  var: range[1], lo: range[2], hi: range[3],
  /* Remaining args are options */
  opts: rest(ax__args, 2),
  traces: [],
  layout_opts: [],
  style: ax__default_style(),
  for item in opts do (
    if ax__is_layout_option(item) then
      layout_opts: endcons(item, layout_opts)
    else if ax__is_trace_option(item) then
      style: ax__apply_option(style, item)
  ),
  /* Build scatterpolar traces */
  for expr in exprs do block(
    [n, data, rs, thetas_deg],
    n: ax__style_get(style, nticks),
    if n = false then n: 500,
    data: ax__sample_1d(expr, var, lo, hi, n),
    /* data[1] = theta values (radians), data[2] = r values */
    /* Plotly scatterpolar expects theta in degrees */
    thetas_deg: map(lambda([t], float(t * 180 / %pi)), data[1]),
    rs: data[2],
    parts: [
      sconcat("\"r\":", ax__float_list_to_json(rs)),
      sconcat("\"theta\":", ax__float_list_to_json(thetas_deg)),
      "\"type\":\"scatterpolar\"",
      "\"mode\":\"lines\"",
      sconcat("\"line\":", ax__build_line_style(style))
    ],
    parts: append(parts, ax__build_trace_style(style, string(expr))),
    traces: endcons(sconcat("{", simplode(parts, ","), "}"), traces)
  ),
  ax__emit_plotly(traces, ax__build_layout_polar(layout_opts)),
  'done
)$
