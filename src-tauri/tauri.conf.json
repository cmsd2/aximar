{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aximar",
  "version": "0.15.2",
  "identifier": "com.aximar.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aximar",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "macnb"
        ],
        "contentTypes": [
          "com.aximar.app.macnb"
        ],
        "name": "Maxima Notebook",
        "description": "Maxima Notebook",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-maxima-notebook+json",
        "exportedType": {
          "identifier": "com.aximar.app.macnb",
          "conformsTo": [
            "public.json"
          ]
        }
      },
      {
        "ext": [
          "ipynb"
        ],
        "name": "Jupyter Notebook",
        "description": "Jupyter Notebook",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/x-ipynb+json"
      }
    ]
  }
}
