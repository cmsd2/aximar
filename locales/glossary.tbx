    </termEntry>
    <termEntry id="t7">
      <langSet xml:lang="en"><tig><term>polynomial (adjective)</term></tig></langSet>
      <langSet xml:lang="es"><tig><term>polinomial</term><note>Maxima</note></tig></langSet>
    </termEntry>
    <termEntry id="t8">
      <langSet xml:lang="en"><tig><term>equation</term></tig></langSet>
