    </termEntry>
    <termEntry id="t29">
      <langSet xml:lang="en"><tig><term>cell</term></tig></langSet>
      <langSet xml:lang="es"><tig><term>celda</term><note>Aximar: a unit of input and output in a notebook, as in Jupyter's Spanish</note></tig></langSet>
    </termEntry>
    <termEntry id="t30">
      <langSet xml:lang="en"><tig><term>notebook</term></tig></langSet>
      <langSet xml:lang="es"><tig><term>cuaderno</term><note>Aximar: the document of cells, as in Jupyter's Spanish</note></tig></langSet>
    </termEntry>
    <termEntry id="t31">
      <langSet xml:lang="en"><tig><term>session</term></tig></langSet>
      <langSet xml:lang="es"><tig><term>sesión</term><note>Aximar: a running Maxima</note></tig></langSet>
    </termEntry>
    <termEntry id="t32">
      <langSet xml:lang="en"><tig><term>run (a cell)</term></tig></langSet>
      <langSet xml:lang="es"><tig><term>ejecutar</term><note>Aximar</note></tig></langSet>
    </termEntry>
    <termEntry id="t33">
      <langSet xml:lang="en"><tig><term>note (on output)</term></tig></langSet>
      <langSet xml:lang="es"><tig><term>nota</term><note>Aximar: a plain-language note on something Maxima printed</note></tig></langSet>
    </termEntry>
    <termEntry id="t34">
      <langSet xml:lang="en"><tig><term>explanation</term></tig></langSet>
