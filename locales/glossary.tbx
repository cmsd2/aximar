<?xml version="1.0" encoding="UTF-8"?>
<!-- Aximar's Spanish glossary.  Terms marked Maxima follow Maxima's own
     Spanish catalog (locale/es.po), so Aximar's words match the Maxima
     messages shown beside them.  See locales/README.md. -->
<martif type="TBX" xml:lang="en">
  <martifHeader>
    <fileDesc><sourceDesc><p>Aximar, seeded from Maxima's es.po</p></sourceDesc></fileDesc>
  </martifHeader>
  <text>
    <body>
    <termEntry id="t1">
      <langSet xml:lang="en"><tig><term>argument</term></tig></langSet>
      <langSet xml:lang="es"><tig><term>argumento</term><note>Maxima: 313 of 314 messages</note></tig></langSet>
    </termEntry>
    <termEntry id="t2">
      <langSet xml:lang="en"><tig><term>matrix</term></tig></langSet>
      <langSet xml:lang="es"><tig><term>matriz</term><note>Maxima</note></tig></langSet>
    </termEntry>
    <termEntry id="t3">
      <langSet xml:lang="en"><tig><term>function</term></tig></langSet>
      <langSet xml:lang="es"><tig><term>función</term><note>Maxima</note></tig></langSet>
    </termEntry>
    <termEntry id="t4">
      <langSet xml:lang="en"><tig><term>list</term></tig></langSet>
      <langSet xml:lang="es"><tig><term>lista</term><note>Maxima</note></tig></langSet>
    </termEntry>
